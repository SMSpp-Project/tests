#!/usr/bin/env bash
#
# usage: batch < exe file >
#        < exe file > = path of the executable file, default
#                       ./MultiFlowDCRBlock_test
#
# runs MultiFlowDCRBlock_test on the instances of the module with the first
# 2 to 5 flows of each network of garr, sndlib and waxman, and with the first
# 2 of each of the 260 networks of topo, in data/nc4/multi of
# SingleFlowDCRBlock (see data/README.md there), each solved by a
# :MILPSolver on the formulation that holds all the flows and by the
# LagrangianDualSolver that relaxes the mutual capacity constraints, once
# with each flow solved by the SingleFlowDCRBendersSolver (BSPar-multi.txt)
# and once by a :MILPSolver (BSPar-multi-milp.txt)
#
# the Lagrangian dual is not tight in general, hence "-R ,r" declares the
# LagrangianDualSolver a relaxation, i.e., its value has to be at most the
# optimum; the instances with 1 flow are not run, since on most networks the
# mutual capacity, 0.8 times the one of each arc when there is one flow, is
# too small for it, and on an infeasible instance the LagrangianDualSolver
# stops without saying so; those of topo with more flows are left out only
# to keep the batch short

# sndlib/sun_2 is not run, since there Gurobi declares optimal a solution
# whose value is 11% above its own bound, the latter agreeing with the
# LagrangianDualSolver
gurobi_fails="sndlib/sun_2"

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

exe=${1:-./MultiFlowDCRBlock_test}
DATADIR=../../SingleFlowDCRBlock/data/nc4/multi

ran=0
for what in "$DATADIR"/{garr,sndlib,waxman}/*_[2-5].nc4 "$DATADIR"/topo/*_2.nc4; do
  [ -f "$what" ] || continue
  ran=1
  inst=${what#"$DATADIR"/}
  case " $gurobi_fails " in *" ${inst%.nc4} "*) continue ;; esac
  run_test "$exe" "$what" -S BSPar-multi.txt -R ,r
  run_test "$exe" "$what" -S BSPar-multi-milp.txt -R ,r
done

# a batch that has found no instance at all has tested nothing, and saying so
# is the only way to tell it apart from one where everything went well
if [ "$ran" -eq 0 ]; then
  echo "No instance found in $DATADIR"
  exit 1
fi

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
