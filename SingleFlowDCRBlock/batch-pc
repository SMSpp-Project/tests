#!/usr/bin/env bash
#
# usage: batch-pc < exe file > < par file > < block config >
#        < exe file >     = path of the executable file, default
#                           ./SingleFlowDCRBlock_test
#        < par file >     = BlockSolverConfig file, default BSPar-pc.txt
#        < block config > = BlockConfig file, default DCRCfg-pc.txt
#
# the same sweep of batch, but on the "P/C" formulation, in which the two
# cone constraints are only outer-approximated by the linear cuts that have
# been separated so far: the :MILPSolver therefore solves a relaxation of
# the DCR problem, which -R declares to the cross-check, and only the bound
# it gives is compared with what the SingleFlowDCRBendersSolver proves
#
# the SingleFlowDCRBendersSolver stops on its own criterion and does not
# declare how much of a gap it leaves, so "-E ,inf" holds it to the base
# Solver contract alone, i.e. to the interval [ get_lb() , get_ub() ]
# containing the optimum
# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../batch_common.sh"

exe=${1:-./SingleFlowDCRBlock_test}
par=${2:-BSPar-pc.txt}
bcf=${3:-DCRCfg-pc.txt}

for n in 10 20 40; do

  m=$(( 3 * n ))

  for t in 1.05 1.5 4; do
    for (( seed = 0 ; seed < 5 ; seed++ )); do

      run_test "$exe" -B "$bcf" -S "$par" -R r, -E ,inf -n "$n" -m "$m" \
               -t "$t" -e "$seed"

    done # seed
  done   # t

done     # n

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
