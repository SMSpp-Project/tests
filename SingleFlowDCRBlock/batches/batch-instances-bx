#!/usr/bin/env bash
#
# usage: batch-instances-bx < exe file >
#        < exe file > = path of the executable file, default
#                       ./SingleFlowDCRBlock_test
#
# runs SingleFlowDCRBlock_test on the instances of the module (see
# batch-instances) with the Solver of BSPar-BX.txt, i.e., the :MILPSolver,
# the SingleFlowDCRBendersSolver and the BranchAndXSolver whose nodes are
# solved by the SFDCRBRelaxationSolver, all in one run and compared with
# each other, in the SOCP formulation, which is exact, so that the value of
# the :MILPSolver is the optimum the other two are held to
#
# the SingleFlowDCRBendersSolver stops on its own criterion and does not
# declare how much of a gap it leaves, and so does the BranchAndXSolver,
# whose nodes are solved by it, so "-E ,inf,inf" holds both to the base
# Solver contract alone, i.e. to the interval [ get_lb() , get_ub() ]
# containing the optimum

# the SOCP formulation is only run where Gurobi solves it whatever its
# numerical focus, the 101 instances where it does not being listed, with
# the reason, in socp-unstable.txt
socp_unstable=$(grep -v '^#' "$(dirname "$0")/../socp-unstable.txt")

# the SOCP formulation is not run either where Gurobi takes minutes on it
socp_too_long="waxman/w1_800_08_7 waxman/w1_800_04_0"

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

exe=${1:-./SingleFlowDCRBlock_test}
DATADIR=../../SingleFlowDCRBlock/data/nc4/single

# in CI the SOCP formulation is not run, and the P/C one on one instance in
# 10, as in batch-instances: there the :MILPSolver solves a relaxation,
# which -R declares, and what is checked is that the bounds are in order
# and that the Solution of the BranchAndXSolver is feasible
if [ -n "$CI" ]; then socp=0; every=10; else socp=1; every=1; fi

# Preserve one log pair per instance, replacing it on the next batch run.
# Override these paths when using configurations with different log names.
tree_log=${BAX_TREE_LOG:-log/RabaxSFCFPRS.log}
relax_log=${BAX_RELAX_LOG:-log/SFDCRBRelaxationSolver.log}
log_root=${BAX_LOG_ROOT:-log}
# The source log directories must exist before the solver opens its files.
mkdir -p "$log_root" "$(dirname "$tree_log")" "$(dirname "$relax_log")" || exit 1
log_marker=$(mktemp "$log_root/.bx-instance-start-XXXXXX") || exit 1
trap 'rm -f "$log_marker"' EXIT
printf 'BranchAndXSolver logs: %s\n' "$log_root"

ran=0
k=0
for what in "$DATADIR"/*/*.nc4; do
  [ -f "$what" ] || continue
  (( k++ % every )) && continue
  inst=${what#"$DATADIR"/}
  if [ "$socp" = 1 ]; then
    case " $(echo $socp_unstable $socp_too_long) " in
      *" ${inst%.nc4} "*) continue ;;
    esac
    ran=1
    touch "$log_marker" || exit 1
    run_test "$exe" "$what" -B DCRCfg-socp.txt -S BSPar-BX.txt -E ,inf,inf
  else
    ran=1
    touch "$log_marker" || exit 1
    run_test "$exe" "$what" -B DCRCfg-pc.txt -S BSPar-BX.txt -R r,, \
             -E ,inf,inf
  fi
  # Dataset + instance keep repeated network names unambiguous. A new run
  # overwrites the previous files for the same instance.
  instance_logs="$log_root/${inst%.nc4}"
  mkdir -p "$(dirname "$instance_logs")" || exit 1
  if [ -f "$tree_log" ] && [ "$tree_log" -nt "$log_marker" ]; then
    cp "$tree_log" "$instance_logs.tree.log" || exit 1
    summary=$(tail -n 1 "$tree_log")
    case "$summary" in
      '[BranchAndXSolver] nodes_evaluated='*) printf '%s\n' "$summary" ;;
      *) printf '[BranchAndXSolver] nodes_evaluated=unavailable\n' ;;
    esac
  else
    printf '[BranchAndXSolver] nodes_evaluated=unavailable\n'
  fi
  if [ -f "$relax_log" ] && [ "$relax_log" -nt "$log_marker" ]; then
    cp "$relax_log" "$instance_logs.relax.log" || exit 1
  fi
done

# a batch that has found no instance at all has tested nothing, and saying so
# is the only way to tell it apart from one where everything went well
if [ "$ran" -eq 0 ]; then
  echo "No instance found in $DATADIR"
  exit 1
fi

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
