#!/usr/bin/env bash
#
# usage: batch-kelley < exe file >
#        < exe file > = path of the executable file,
#        default ./PolyhedralFunctionBlock_test
#
# The battery of batch with the BundleSolver of NDOPar-Kelley.txt, i.e., the
# cutting-plane method of Kelley with the primal and with the dual master
# problem, on the instances where its master does not become unbounded (the
# first seed, no or one sub-Block with a linear objective, up to 30% of
# vertical rows); the variables of batch can still be set.

sconf=${sconf:-NDOPar-Kelley.txt} seeds=${seeds:-1} nfs=${nfs:-"0 1"} \
verts=${verts:-"0 0.1 0.3"} sizes=${sizes:-"10"} \
  exec bash "$(dirname "$0")/batch" "$@"
