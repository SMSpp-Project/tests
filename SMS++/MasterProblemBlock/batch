#!/usr/bin/env bash
#
# usage: batch < exe file >
#        < exe file > = path of the executable file,
#        default ./MasterProblemBlock_test
#
# Tester batch for the Solver of a MasterProblemBlock, those of
# MPBSolvers.txt against the first one. Sweeps over:
#   - the shape of the master problem: one component or several, short
#     cuts (few variables, many cuts) or long ones (many variables, few
#     cuts), given as triplets "N K M" (variables, components, cuts of each)
#   - the lower bounds on the components (lbs), the level (levels), the box
#     on none, half or all the variables (boxes), the linear part (lins)
#     and the fraction of vertical rows (verts)
#
# Tunable via environment variables:
#   - shapes: list of "N:K:M" (default: "4:1:20 4:5:20 100:1:5 100:5:5")
#   - lbs, levels, boxes, lins, verts: the values of each axis (defaults:
#     "0 1", "0 1", "0 1 2", "0 1", "0 0.3")
#   - what:  bit-mask of changes (default: 255, all of them)
#   - iter:  number of rounds (default: 10)
#   - nchg:  number of changes per round (default: 3)
#   - pchg:  probability of each kind of change (default: 0.5)
#   - seeds: number of random seeds per configuration (default: 1)

SECONDS=0
shapes=${shapes:-"4:1:20 4:5:20 100:1:5 100:5:5"}
lbs=${lbs:-"0 1"}
levels=${levels:-"0 1"}
boxes=${boxes:-"0 1 2"}
lins=${lins:-"0 1"}
verts=${verts:-"0 0.3"}
what=${what:-255}
iter=${iter:-10}
nchg=${nchg:-3}
pchg=${pchg:-0.5}
seeds=${seeds:-1}

MasterProblemBlock_test=${1:-./MasterProblemBlock_test}
cases=0
failures=0
skipped=0

for shape in $shapes; do
  IFS=: read -r N K M <<< "$shape"
  for lb in $lbs; do
    for lev in $levels; do
      for box in $boxes; do
        for lin in $lins; do
          for vert in $verts; do
            for (( seed = 0 ; seed < seeds ; seed++ )); do
              args="-e $seed -k $what -n $iter -m $nchg -q $pchg -N $N"
              args="$args -K $K -M $M -L $lb -l $lev -x $box -b $lin"
              args="$args -V $vert"
              printf "[%s]: " "$args"
              "$MasterProblemBlock_test" $args -S MPBSolvers.txt | tail -1
              retVal=${PIPESTATUS[0]}
              cases=$(( cases + 1 ))
              if [ $retVal -eq 77 ]; then
                skipped=$(( skipped + 1 ))
              elif [ $retVal -ne 0 ]; then
                failures=$(( failures + 1 ))
                printf "FAILED(exit=%d)\n" "$retVal"
              fi
            done
          done
        done
      done
    done
  done
done

printf "\nTotal elapsed time: %02d:%02d:%02d\n" \
  $((SECONDS/3600)) $((SECONDS%3600/60)) $((SECONDS%60))
printf "Completed cases: %d; failures: %d\n" "$cases" "$failures"

# nothing to compare in this build
if [ $skipped -eq $cases ]; then
  exit 77
fi
exit $(( failures > 0 ))
