#!/usr/bin/env bash
#
# usage: batch-long < exe file >
#        < exe file > = path of the executable file,
#        default ./MasterProblemBlock_test
#
# The battery of batch over more seeds and rounds and over larger master
# problems, for the correctness of the Solver rather than for the CI; the
# variables of batch can still be set.

shapes=${shapes:-"2:1:50 4:1:200 4:10:50 100:1:20 100:10:20 1000:1:10"} \
seeds=${seeds:-5} iter=${iter:-50} \
  exec bash "$(dirname "$0")/batch" "$@"
