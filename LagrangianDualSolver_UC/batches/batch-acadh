#!/usr/bin/env bash
#
# usage: batch-acadh < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable file, default LDS_UC_test
#        < par file > = BlockSolverConfig file, default BSPar-2S.txt
#        < solver > = 0 or 1, default 0
#        < log file > = name of log file, default no log
#
# runs the hydrothermal academic instances
#
# for LagrangianDualSolver + BundleSolver:
# correct value of tStar: 1e+0

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./LDS_UC_test
DEFAULT_PAR=BSPar-2S.txt
DEFAULT_SLV=0
parse_batch_args "$@"

# hydrothermal academic instances - - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/UC_Data/HT-Ramp

# under PrimalProximalHeur (slv=1, via metabatch-PPH) the larger instances do
# not converge within the 3h shared-runner cap, so under PPH the CI runs only
# the smallest instance; under slv=0 it keeps a small/medium/large sample. Local
# runs the whole grid in both modes.
if [ -n "$CI" ]; then
  if [ "$slv" = "1" ]; then sizes="20_10";                seeds="1"
  else                      sizes="20_10 100_50 200_100"; seeds="1"; fi
else                        sizes="20_10 50_20 75_35 100_50 150_75 200_100"; seeds="1 2"; fi

for size in $sizes; do
  for seed in $seeds; do

    what=${DATADIR}/${size}_${seed}_w.nc4

    run_test "$exe" "$what" -S "$par" -B InnerBCfg.txt -w "$slv"

  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

