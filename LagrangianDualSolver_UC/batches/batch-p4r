#!/usr/bin/env bash
#
# usage: batch-p4r < exe file > < par file > < solver > < log file >
#        < par file > = BlockSolverConfig file, default BSPar-2S.txt
#        < solver > = 0 or 1, default 0
#        < log file > = name of log file, default no log
#        < exe file > = path of the executable file, default LDS_UC_test
#
# runs all the plan4res public instances, with the same configuration:
#
#   FirstSetofInstances   single-node thermal and hydrothermal UCBlocks
#   SecondSetofInstances  richer UCBlocks (hydro systems with polyhedral inflow
#                         values, intermittent units, batteries, up to several
#                         nodes and over a thousand units; the four reserve-
#                         bearing ones L_B_C_26 / L_B_C_31 / L_B_C_32 / L_H_C_34
#                         also feed the 1UC_TUB single-unit instances used by
#                         the ThermalUnitBlock_Solver test)
#   pHydro                single-node thermal fleet coupled to a cascade of
#                         HydroUnitBlocks placed directly under the UCBlock
#
# for LagrangianDualSolver + BundleSolver:
# correct value of tStar: 1e-2
# correct value of dblCtOff: 0.1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./LDS_UC_test
DEFAULT_PAR=BSPar-2S.txt
DEFAULT_SLV=0
parse_batch_args "$@"

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/plan4res-data

# the 25 SecondSetofInstances (~11MB each, hydro systems with over a thousand
# units on several nodes) take many minutes apiece and blow the 3h GitLab.com
# shared-runner cap on their own; run only the light sets in CI. Local runs all.
if [ -n "$CI" ]; then
    sets="FirstSetofInstances pHydro"
else
    sets="FirstSetofInstances SecondSetofInstances pHydro"
fi

for s in $sets; do
    for what in "${DATADIR}/${s}"/*.nc4; do

        run_test "$exe" "$what" -S "$par" -B InnerBCfg.txt -w "$slv"

    done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
