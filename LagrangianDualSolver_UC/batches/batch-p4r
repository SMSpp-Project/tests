#!/usr/bin/env bash
#
# usage: batch-p4r < exe file > < par file > < solver > < log file >
#        < par file > = BlockSolverConfig file, default BSPar-2S.txt
#        < solver > = 0 or 1, default 0
#        < log file > = name of log file, default no log
#        < exe file > = path of the executable file, default LDS_UC_test
#
# runs all the plan4res public instances
#
# for LagrangianDualSolver + BundleSolver:
# correct value of tStar: 1e-2
# correct value of dblCtOff: 0.1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./LDS_UC_test
DEFAULT_PAR=BSPar-2S.txt
DEFAULT_SLV=0
parse_batch_args "$@"

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ../../UCBlock/data/nc4/plan4res-data/FirstSetofInstances/*.nc4; do

    run_test "$exe" "$what" "$par" "$slv"

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
