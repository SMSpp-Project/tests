#!/usr/bin/env bash
#
# usage: metabatch-PPH < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default ./LDS_UC_test
#        < par file > = BlockSolverConfig file, default ProxHeur-2S.txt
#        < log file > = name of log file, default none
#
# runs all the instances with < solver > == 1 (PrimalProximalHeur).
# The argument order matches that of the per-instance batches (batch-acad,
# batch-ec, ...) so a single CMake command can invoke either kind uniformly.

# command line parameter setup- - - - - - - - - - - - - - - - - - - - - - - -

if [ $# -gt 0 ]; then
   exe=$1
else
   exe=./LDS_UC_test
fi
if [ $# -gt 1 ]; then
   par=$2
else
   par=ProxHeur-2S.txt
fi
if [ $# -gt 2 ]; then
   mlf=$3
fi
slv=1

# run academic instances
./batches/batch-acad "$exe" "$par" "$slv" "$mlf"

# run small thermal academic instances
./batches/batch-acad-s "$exe" "$par" "$slv" "$mlf"

# run hydrothermal academic instances
./batches/batch-acadh "$exe" "$par" "$slv" "$mlf"

# run plan4res instances. Under PPH these are the slowest part of the metabatch;
# the smoke sample already runs them under slv=0 in the standalone batch-p4r
# test, so skip them here in CI to stay under the 3h shared-runner cap. Local
# still exercises the full plan4res set under PrimalProximalHeur.
if [ -z "$CI" ]; then
    ./batches/batch-p4r "$exe" "$par" "$slv" "$mlf"
fi

# run energy community instances
./batches/batch-ec "$exe" "$par" "$slv" "$mlf"

# resilient instances are skipped in PPH mode: they are pure-LD on a single
# ECNetworkBlock-like easy component (all-easy BundleSolver decomposition),
# and they carry no binary Variable, so PrimalProximalHeur has nothing to
# add over plain LagrangianDualSolver and would need the EASY BSPar variant
# anyway. Keep them in the regular metabatch (slv=0) instead.
#./batches/batch-resilient "$exe" "$par" "$mlf"

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
