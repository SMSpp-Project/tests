#!/usr/bin/env bash
#
# usage: batch-acad-s < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable file, default LDS_UC_test
#        < par file > = BlockSolverConfig file, default BSPar-2S.txt
#        < solver > = 0 or 1, default 0
#        < log file > = name of log file, default no log
#
# runs only "small" pure thermal academic instances, intended for being used
# when the ThermalUnitBlock subproblems are solved to integer optimality
# (typically using ThermalUnitExtDPSolver, although a :MILPSolver would
# be a less efficient option)
#
# for LagrangianDualSolver + BundleSolver:
# correct value of tStar: 1e+0

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./LDS_UC_test
DEFAULT_PAR=BSPar-2S.txt
DEFAULT_SLV=0
parse_batch_args "$@"

# small thermal academic instances- - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/UC_Data/T-Ramp

# under PrimalProximalHeur (slv=1, via metabatch-PPH) the size-50 instances do
# not converge within the 3h shared-runner cap (e.g. 50_0_1 runs for hours), so
# under PPH the CI runs only the fast size-10 instances. Local runs them all.
if [ -n "$CI" ] && [ "$slv" = "1" ]; then sizes="10"
else                                       sizes="10 20 50"; fi

for size in $sizes; do
  for (( seed = 1 ; seed < 6 ; seed++ )); do

    what=${DATADIR}/${size}_0_${seed}_w.nc4

    run_test "$exe" "$what" -S "$par" -B InnerBCfg.txt -w "$slv"

  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
