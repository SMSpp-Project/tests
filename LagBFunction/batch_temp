#!/usr/bin/env bash

source "$(dirname "$0")/../batch_common.sh"

LagBFunction_test=${1:-./LagBFunction_test}

# No Modification is enabled and no modification round is executed: each
# invocation only builds and solves the initial instance.
what=0
rounds=0

for nf in -2 -11; do

  if [ "$nf" -eq -2 ]; then
    nt=-1
  else
    nt=-3
  fi

  # nt is always positive, so every LagBFunction is a hard component.
  for size in 2 10 50; do
    for dens in 3 1.1; do
      for (( seed = 0 ; seed < 20 ; seed++ )); do

        run_test "$LagBFunction_test" "$seed" "$what" "$size" "$nf" \
                 "$nt" "$dens" "$rounds"

      done
    done
  done
done
