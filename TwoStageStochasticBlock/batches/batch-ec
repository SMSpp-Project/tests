#!/usr/bin/env bash
#
# usage: batch-ec < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable file, default TSSB_test
#        < par file > = BlockSolverConfig file, default BSPar-2S.txt
#        < solver > = 0 or 1, default 0
#        < log file > = name of log file, default no log
#
# runs all the stochastic energy community instances and checks that the
# EnergyCommunity.jl@stochastic objective value matches the given reference one

# command line parameter setup- - - - - - - - - - - - - - - - - - - - - - - -

if [ $# -gt 0 ]; then
   exe=$1
else
   exe=./TSSB_test
fi
if [ $# -gt 1 ]; then
   par=$2
else
   par=BSPar-2S.txt
fi
if [ $# -gt 2 ]; then
   slv=$3
else
   slv=0
fi
if [ $# -gt 3 ]; then
   mlf=$4
fi

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = | EnergyCommunity.jl@stochastic objective value |
# (see more at https://github.com/SPSUnipi/EnergyCommunity.jl, branch
# `stochastic`).
# The values come from the test harness in
# UCBlock/tools/csv2netCDF/test_instance_with_EC_jl.jl run as follows:
#   CO          --no-thermal  →  TSSB_EC_CO_Test{,_NB}.nc4
#   CO          (no flag)     →  TSSB_EC_CO_Test_TUB{,_NB}.nc4
#   CO          --no-asset    →  TSSB_EC_NA_Test{,_NB}.nc4
#   NC          --no-thermal  →  TSSB_EC_NC_Test{,_NB}.nc4
#   NC          (no flag)     →  TSSB_EC_NC_Test_TUB{,_NB}.nc4
# (NA YAMLs were dropped in favor of CO + --no-asset, since they were
# identical to CO but with all installable assets disabled)
# --no-thermal / --no-asset fix the corresponding x_us decisions to 0
# in EnergyCommunity.jl@stochastic, so the EC.jl model matches the SMS++
# instance produced by csv2nc4.jl.

declare -A REF_OBJ

REF_OBJ[TSSB_EC_CO_Test.nc4]=3.587883106e+06
REF_OBJ[TSSB_EC_CO_Test_NB.nc4]=3.587883106e+06

REF_OBJ[TSSB_EC_CO_Test_TUB.nc4]=3.552484696e+06
REF_OBJ[TSSB_EC_CO_Test_TUB_NB.nc4]=3.552484696e+06

REF_OBJ[TSSB_EC_NA_Test.nc4]=3.981238724e+06
REF_OBJ[TSSB_EC_NA_Test_NB.nc4]=3.981238724e+06

REF_OBJ[TSSB_EC_NC_Test.nc4]=3.757320861e+06
REF_OBJ[TSSB_EC_NC_Test_NB.nc4]=3.757320861e+06

REF_OBJ[TSSB_EC_NC_Test_TUB.nc4]=3.717429193e+06
REF_OBJ[TSSB_EC_NC_Test_TUB_NB.nc4]=3.717429193e+06

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ../../UCBlock/data/nc4/EC_Data/TSSB_EC_CO_*.nc4 \
            ../../UCBlock/data/nc4/EC_Data/TSSB_EC_NA_*.nc4 \
            ../../UCBlock/data/nc4/EC_Data/TSSB_EC_NC_*.nc4; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    base=$(basename "$what")
    ref=${REF_OBJ[$base]}

    if [ -z "$ref" ]; then
      echo "No reference objective defined for file: $base"
      exit 1
    fi

    if [ -z "$mlf" ]; then
       printf "[$what $par $slv $ref]: "
       "$exe" "$what" "$par" "$slv" "$ref"
    else
       printf "[$what $par $slv $ref]: " >> "$mlf"
       "$exe" "$what" "$par" "$slv" "$ref" >> "$mlf"
    fi

#    retVal=$?
#    if [ $retVal -ne 0 ]; then
#      exit 1
#    fi

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
