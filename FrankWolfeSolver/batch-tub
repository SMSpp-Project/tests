#!/usr/bin/env bash
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# batch-tub : the ThermalUnitBlock decomposition test for FrankWolfeSolver.
#
# Each run builds a father AbstractBlock with a random DQuadFunction objective
# over the physical variables (p_thermal, u_thermal, via -V) of K ThermalUnit-
# Block copies, configured in the DP + Perspective-Cuts formulation (the
# BlockConfig TUBCfg-DP.txt). A ThermalUnitDPSolver is the LMO of each unit;
# SolveAll() then cross-checks the FrankWolfeSolver bound (intCvxComb = 1, i.e.
# the Dantzig-Wolfe value) against a monolithic :MILPSolver solving the
# continuous, cut-separated relaxation (intRelaxIntVars = 2). Since DP + P/C
# characterizes the convex hull of the unit's integer solutions, the two values
# must agree, i.e. Frank-Wolfe is a decomposition alternative to DP + P/C.
#
# This is a SLOW batch (the reference :MILPSolver solves a monolithic relaxation
# with a cut-separation loop, and Frank-Wolfe converges sublinearly): expect
# minutes per run. The exact command line and FWCfg-tub.txt overrides are
# printed in brackets before each run so a failing case can be reproduced.
#
# usage:  ./batch-tub [ <exe> ]      ( default ./FWS_test )
#
# NOTE (macOS/SIP): run as `bash batch-tub` (not ./batch-tub) so an ambient
# DYLD_LIBRARY_PATH survives, or have the solver libraries resolvable via rpath.
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
set -u

EXE=${1:-./FWS_test}
DATA=../../UCBlock/data/nc4/1UC_Data
CFG=FWCfg-tub.txt

SAVE=$( cat "$CFG" )
trap '[ -n "$SAVE" ] && printf "%s\n" "$SAVE" > "$CFG"' EXIT

setpar() { sed -i.bak "s/^$1 *[0-9][0-9eE.+-]*/$1   $2/" "$CFG" && rm -f "$CFG.bak"; }
algo()    { setpar intAlgorithm "$1"; CUR_ALGO=$1; }
atoms()   { setpar intMaxAtoms  "$1"; CUR_ATOMS=$1; }
relacc()  { setpar dblRelAcc    "$1"; CUR_RACC=$1; }
CUR_ALGO=0 ; CUR_ATOMS=0 ; CUR_RACC=1e-7

pass=0 ; fail=0
run() {  # $1 = description ; rest = tester arguments
  local desc=$1 ; shift
  echo "=== $desc ==="
  # exact command line + the in-place FWCfg-tub.txt overrides, so a failing run
  # can be reproduced verbatim (the file is mutated in place, restored on exit)
  printf "    [%s %s]\n" "$EXE" "$*"
  printf "    [FWCfg-tub.txt: intAlgorithm=%s intMaxAtoms=%s dblRelAcc=%s]\n" \
         "$CUR_ALGO" "$CUR_ATOMS" "$CUR_RACC"
  local t0=$( date +%s )
  local out ; out=$( "$EXE" "$@" 2>&1 )
  local t1=$( date +%s )
  printf "%s\n" "$out" | grep -E "S0 =|passed|Shit" | tail -3 | sed 's/^/    /'
  printf "    elapsed: %ds\n" "$(( t1 - t0 ))"
  if printf "%s" "$out" | grep -q "passed" ; then pass=$(( pass + 1 ))
  else fail=$(( fail + 1 )) ; fi
}

# common arguments of the ThermalUnitBlock test: meta-BSC, DP+P/C BlockConfig,
# the physical variable groups for the father objective, DQuad father (-o 0)
TUBARGS="-S BSPar-tub.txt -B TUBCfg-DP.txt -V p_thermal,u_thermal -o 0"

echo "########## 96-period units, vanilla Frank-Wolfe ##########"
algo 0 ; relacc 1e-7
run "S1ramp17_96 k=2 vanilla"  $TUBARGS -k 2 -e 1 $DATA/96/S1ramp17_96.nc4
run "S12ramp10_96 k=2 vanilla" $TUBARGS -k 2 -e 1 $DATA/96/S12ramp10_96.nc4

echo "########## 96-period units, Away-step (active set) ##########"
algo 1
run "S1ramp17_96 k=3 away"     $TUBARGS -k 3 -e 1 $DATA/96/S1ramp17_96.nc4

echo "########## 384-period unit, vanilla (slower) ##########"
algo 0
run "S1ramp1_384 k=2 vanilla"  $TUBARGS -k 2 -e 1 $DATA/384/S1ramp1_384.nc4

echo "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
printf "BATCH-TUB: %d passed, %d failed\n" "$pass" "$fail"
[ "$fail" -eq 0 ]
