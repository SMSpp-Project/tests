#!/usr/bin/env bash
#
# usage: batch-c < exe file >
#        < exe file > = path of the executable file, default ./LDS_MMCF_test
#
# runs the Canad MMCF instances through LagrangianDualSolver

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../batch_common.sh"

DATADIR=../MMCFBlock/data

LDS_MMCF_test=${1:-./LDS_MMCF_test}

for what in ${DATADIR}/Canad/*.dat; do

  run_test "$LDS_MMCF_test" "$what" s

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
