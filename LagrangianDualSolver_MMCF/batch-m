#!/usr/bin/env bash
#
# usage: batch-m < exe file >
#        < exe file > = path of the executable file, default ./LDS_MMCF_test
#
# runs the Mnetgen MMCF instances through LagrangianDualSolver

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../batch_common.sh"

DATADIR=../MMCFBlock/data

LDS_MMCF_test=${1:-./LDS_MMCF_test}

# Mnetgen - - - - - - - - - - - - - - - - - - - -

for i in 64; do
  for j in 4 8 16 32 64; do
    for (( h = 1 ; h < 13 ; h++ )); do

      what=${DATADIR}/Mnetgen/$i-$j-$h

      run_test "$LDS_MMCF_test" "$what" -B BPar.txt -S BSPar.txt -t m

    done
  done
done

for i in 128; do
  for j in 4 8 16 32 64 128; do
    for (( h = 1 ; h < 13 ; h++ )); do

      what=${DATADIR}/Mnetgen/$i-$j-$h

      run_test "$LDS_MMCF_test" "$what" -B BPar.txt -S BSPar.txt -t m

    done
  done
done

