#!/usr/bin/env bash
#
# usage: batch-nc4-ref < exe file > < solver > < log file >
#        < exe file > = path of the bkbench tool, default ./bkbench
#        < solver > = Solver factory name, default = bkbench's own default
#                     (CoreDPBinaryKnapsackSolver)
#        < log file > = name of log file, default no log
#
# Solver-vs-REFERENCE cross-check on the curated Pisinger instances: each
# curated class is a single .csv that carries, per instance, the PUBLISHED
# Pisinger optimum z (and x*). bkbench solves every instance of a .csv in ONE
# process (no per-instance start-up) with our exact solver and checks its
# optimum matches z. This complements the solver-vs-solver batch-nc4 (DP vs
# MILP): there we check internal agreement, here we validate our objective
# value against the literature optimum -- semantically the same check the
# block_solver-based version did, only orders of magnitude faster.
#
# The raw .csv are kept next to the stripped instances by data/fetch-txt and
# shipped in the curated txt.tgz (produced by the run_bk2nc4 fixture, see the
# test CMakeLists). If no .csv is found the check is skipped.

set -u

# run from the test directory so the configuration files are read there
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers (colors) - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./bkbench
exe="${1:-$DEFAULT_EXE}"
slv="${2:-}"                     # optional Solver name (default = CoreDP)

csvdir="../../BinaryKnapsackBlock/data/txt"

shopt -s globstar nullglob
csvs=( "$csvdir"/*.csv )

if [ "${#csvs[@]}" -eq 0 ]; then
  echo "SKIP batch-nc4-ref: no curated Pisinger .csv under $csvdir"
  echo "  (regenerate the curated data with data/fetch-txt, which keeps the"
  echo "   raw .csv carrying the published optima, to enable this cross-check)"
  exit 0
fi

n=0; fail=0
for csv in "${csvs[@]}"; do
  out=$( "$exe" "$csv" 0.5 ${slv:+"$slv"} 2>&1 ); rc=$?
  echo "$out" | grep -E "^MISMATCH"          # surface any mismatching instance
  echo "$out" | grep -E ": n="               # the per-class summary line
  ni=$( echo "$out" | grep -E ": n=" | tail -1 | sed -nE 's/.* n=([0-9]+).*/\1/p' )
  n=$(( n + ${ni:-0} ))
  [ "$rc" -ne 0 ] && fail=1
done

echo "checked $n instance(s) against the published Pisinger optima (via bkbench)"
if [ "$fail" = "0" ] && [ "$n" -gt 0 ]; then
  echo -e "${GREEN}All tests passed!!${NC}"
else
  echo -e "${RED}Errors happened!!${NC}"
  exit 1
fi

