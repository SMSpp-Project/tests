#!/usr/bin/env bash
#
# usage: batch-nc4-ref < exe file > < par file > < log file >
#        < exe file > = path of the SMS++ generic block_solver tool,
#                       default ./block_solver
#        < par file > = BlockSolverConfig of the solver under test,
#                       default BKBSCfg-CDP.txt (the core DP)
#        < log file > = name of log file, default no log
#
# Solver-vs-REFERENCE cross-check on the curated Pisinger instances: for every
# .nc4 under BinaryKnapsackBlock/data/nc4, solve it with one of our exact
# solvers and check its optimum matches the PUBLISHED Pisinger optimum z,
# recorded per instance in the optima.csv sidecars written by data/fetch-txt.
# This complements the solver-vs-solver batch-nc4 (DP vs MILP): there we check
# internal agreement, here we validate our objective value against the
# literature optimum.
#
# The .nc4 instances and the optima.csv are produced by the run_bk2nc4 fixture
# (see the test CMakeLists). If no optima.csv is found (a curated archive
# published before fetch-txt recorded the optima), the check is skipped.

set -u

# run from the test directory so the configuration files are read there
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers (colors, parse_batch_args) - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./block_solver
DEFAULT_PAR=BKBSCfg-CDP.txt
parse_batch_args "$@"

txtdir="../../BinaryKnapsackBlock/data/txt"
nc4dir="../../BinaryKnapsackBlock/data/nc4"

shopt -s globstar nullglob

# build the instance -> published-optimum map from the optima.csv sidecars
declare -A OPT
nopt=0
for o in "$txtdir"/**/optima.csv; do
  while IFS=, read -r name z; do
    [ -n "$name" ] || continue
    OPT["$name"]="$z"
    nopt=$((nopt + 1))
  done < "$o"
done

if [ "$nopt" -eq 0 ]; then
  echo "SKIP batch-nc4-ref: no published optima found under $txtdir"
  echo "  (regenerate the curated data with data/fetch-txt, which now records"
  echo "   the Pisinger optimum of each instance, to enable this cross-check)"
  exit 0
fi

# the optimum reported by block_solver for the given config / instance
bound() { "$exe" -S "$1" "$2" 2>/dev/null | awk '/Lower bound/{print $4}'; }

n=0; fail=0
for f in "$nc4dir"/**/*.nc4; do
  base="$(basename "${f%.nc4}")"
  z="${OPT[$base]:-}"
  [ -n "$z" ] || continue          # no published reference for this instance
  n=$((n + 1))
  v=$(bound "$par" "$f")
  ok=$(awk -v a="$v" -v b="$z" 'BEGIN {
         if( a == "" ) { print 0; exit }
         d = a - b; if( d < 0 ) d = -d;
         m = (b < 0 ? -b : b); if( m < 1 ) m = 1;
         print ( d <= 2e-5 * m ) ? 1 : 0 }')
  if [ "$ok" != "1" ]; then
    echo "MISMATCH ${f#$nc4dir/}: solver=$v z(Pisinger)=$z"
    fail=1
  fi
done

echo "checked $n instance(s) against the published Pisinger optima"
if [ "$fail" = "0" ] && [ "$n" -gt 0 ]; then
  echo -e "${GREEN}All tests passed!!${NC}"
else
  echo -e "${RED}Errors happened!!${NC}"
  exit 1
fi

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
