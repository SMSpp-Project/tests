#!/usr/bin/env bash
#
# usage: batch-mixed < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable, default BinaryKnapsackBlock_test
#        < par file > = BlockSolverConfig file, default BSPar-mixed.txt
#        < solver > = unused
#        < log file > = name of log file, default no log
#
# Cross-check on MIXED-binary instances (some continuous variables,
# 0 < nI < 1): attaches at once every solver that handles continuous variables
# and must give the same optimum (see BSPar-mixed.txt) -- the exact
# :MILPSolver, the full-table / parallel / core DP -- while the greedy
# relaxation must bracket it. The BranchAndXSolver is excluded: it branches on
# binary variables (see batch for the pure-binary cross-check).

# run from the test directory so BinaryKnapsackBlock_test reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./BinaryKnapsackBlock_test
DEFAULT_PAR=BSPar-mixed.txt
parse_batch_args "$@"

# fixed harness parameters - - - - - - - - - - - - - - - - - - - - - - - - -
seed=264
wchg=63
n_repeat=10

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for N in 50 100 200; do

  for delta in 0.01 0.1 0.6; do

    for nI in 0.3 0.6; do        # fraction of integer variables ( < 1: mixed )

      for nW in 0 0.2; do

        for nP in 0 0.2; do

          for nM in 0 0.2; do

            run_test "$exe" -S "$par" -e "$seed" -k "$wchg" -N "$N" -n "$n_repeat" -d "$delta" -W "$nW" -P "$nP" -i "$nI" -M "$nM"

          done
        done
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
