#!/usr/bin/env bash
#
# usage: batch < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable, default BinaryKnapsackBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < solver > = unused
#        < log file > = name of log file, default no log
#
# Cross-check on PURE-BINARY instances (nI = 1): every solver /
# formulation that must give the same integer optimum is attached at once (see
# BSPar.txt) and SolveAll() checks they all agree -- the exact :MILPSolver,
# the full-table / parallel / core DP, and the BranchAndXSolver in each of its
# exploration modes -- while the greedy relaxation must bracket that optimum.
# This replaces the former one-batch-per-formulation correctness tests.

# run from the test directory so BinaryKnapsackBlock_test reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./BinaryKnapsackBlock_test
DEFAULT_PAR=BSPar.txt
parse_batch_args "$@"

# fixed harness parameters - - - - - - - - - - - - - - - - - - - - - - - - -
# (the sweep is leaner than the single-formulation batches: every instance is
# solved by all the ~11 attached solvers)
seed=264
wchg=63
n_repeat=10
nI=1

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for N in 50 100 200; do

  for delta in 0.01 0.1 0.6; do

    for nW in 0 0.2; do

      for nP in 0 0.2; do

        for nM in 0 0.2; do

          run_test "$exe" -S "$par" -e "$seed" -k "$wchg" -N "$N" -n "$n_repeat" -d "$delta" -W "$nW" -P "$nP" -i "$nI" -M "$nM"

        done
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
