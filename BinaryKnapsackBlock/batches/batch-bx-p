#!/usr/bin/env bash
#
# usage: batch-bx-p < exe file > < par file > < solver > < log file >
#        < exe file > = path of the executable file, default BinaryKnapsackBlock_test
#        < par file > = BlockSolverConfig file, default BSPar-BX-P.txt
#        < solver > = unused
#        < log file > = name of log file, default no log
#
# sweeps BinaryKnapsackBlock_test over instance sizes, densities and the
# negative weights/profits fractions, with runtime mutations, checking the
# PARALLEL (DFS, 4 workers, see BSPar-BX-P.txt) BranchAndXSolver against an
# exact :MILPSolver each round: both must agree on the integer optimal
# value. All the variables are integer (nI = 1), as the Branch-and-X
# explores binary branchings. The sweep is smaller than batch-bx's: the
# point is exercising the concurrent machinery, not re-testing the leaf.

# run from the test directory so BinaryKnapsackBlock_test reads its config
# files there
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./BinaryKnapsackBlock_test
DEFAULT_PAR=BSPar-BX-P.txt
parse_batch_args "$@"

# fixed harness parameters - - - - - - - - - - - - - - - - - - - - - - - - -
seed=264
wchg=63
n_repeat=25
nI=1

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for N in 100 400; do

  for delta in 0.005 0.05 0.6; do

    for nW in 0 0.2; do

      for nP in 0 0.2; do

        for nM in 0 0.2; do

          run_test "$exe" -S "$par" -e "$seed" -k "$wchg" -N "$N" -n "$n_repeat" -d "$delta" -W "$nW" -P "$nP" -i "$nI" -M "$nM"

        done
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
