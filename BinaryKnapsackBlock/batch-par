#!/usr/bin/env bash
##############################################################################
############################### batch-par ####################################
##############################################################################
#                                                                            #
#   Scaling benchmark for ParallelDPBinaryKnapsackSolver.                    #
#                                                                            #
#   Sweeps the number of workers (intMaxThread) over a set of fixed pure-    #
#   integer knapsack instances and reports the dynamic-programming solve     #
#   time and the speedup against the serial baseline (intMaxThread = 1,      #
#   which delegates to the pruning serial DP of DPBinaryKnapsackSolver).     #
#                                                                            #
#   No :MILPSolver is attached (see BinaryKnapsackPar-par.txt), and no       #
#   modifications are applied (nM = 0): the timing is the single full DP     #
#   solve at iteration 0. Requires the timing-enabled bench binary, built    #
#   by the BinaryKnapsackBlock_bench CMake target (LOG_LEVEL = 1).           #
#                                                                            #
#   Usage: ./batch-par [ bench-executable ] [ config-file ]                  #
#                                                                            #
#                              Donato Meoli                                  #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################
set -euo pipefail

BENCH=${1:-../../cmake-build-release/tests/BinaryKnapsackBlock/BinaryKnapsackBlock_bench}
# fixed instance-generation parameters (pure integer knapsack, no
# modifications: we time the single full DP solve at iteration 0)
seed=264 ; wchg=127 ; n_repeat=1 ; delta=0.9
nW=0.2 ; nP=0.2 ; nI=1 ; nM=0

THREADS="1 2 4 8"
SIZES="1000 3000 5000 8000"

# the .txt suffix matters: Configuration::deserialize() dispatches on it
# (no suffix => it is parsed as a netCDF file and fails)
tmp=$( mktemp --suffix=.txt )
trap 'rm -f "$tmp"' EXIT

# write a single-solver BlockSolverConfig (no :MILPSolver, for pure DP timing)
# with $1 = intMaxThread workers and $2 = intWhichParallel engine into $tmp
mkcfg() {
  cat > "$tmp" <<EOF
BlockSolverConfig
1
1
ParallelDPBinaryKnapsackSolver
1
ComputeConfig
1
2
intMaxThread    $1
intWhichParallel    $2
1
dblReopt        0.3
0
0
0
0
*
EOF
}

# extract the first-iteration DP solve time from the bench output line
#   "0: <dp_time> - <re-solve_time> - OK(f)"
dp_time() { awk -F' - ' '/^0:/ { split( $1 , a , ": " ) ; print a[ 2 ] }' ; }

# run the bench for the current $N with $1 workers and $2 engine, echo DP time;
# capture the whole output first so the bench is never hit by SIGPIPE
run() {
  mkcfg "$1" "$2"
  local out
  out=$( BKB_BSCFG="$tmp" "$BENCH" $seed $wchg $N $n_repeat $delta $nW $nP $nI $nM \
         2>&1 )
  printf '%s\n' "$out" | dp_time
}

printf '%8s%12s' "N" "serial"
for T in $THREADS ; do printf '%12s' "FF(${T}w)" ; done
printf '%12s\n' "best-sp"

for N in $SIZES ; do
  printf '%8s' "$N"
  ser=$( run 1 -1 )                       # intWhichParallel = -1 => serial base
  printf '%12s' "$ser"
  best=""
  for T in $THREADS ; do
    t=$( run "$T" 1 )                     # intWhichParallel = 1 => FastFlow
    printf '%12s' "$t"
    best=$( awk -v b="$best" -v t="$t" \
            'BEGIN { if( b == "" ) print t ; else print ( t < b ) ? t : b }' )
  done
  awk -v s="$ser" -v b="$best" \
      'BEGIN { if( b + 0 > 0 ) printf "%11.2fx\n" , s / b ; else print "        n/a" }'
done

echo
echo "serial  = intWhichParallel=-1 (auto: serial base DP)"
echo "FF(Nw)  = intWhichParallel=1  (FastFlow) with intMaxThread=N"
echo "best-sp = t(serial) / min over N of t(FF)  ( > 1 = parallel wins )"
