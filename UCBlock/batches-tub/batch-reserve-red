#!/usr/bin/env bash
#
# usage: batch-reserve-red < exe file >
#        < exe file > = path of the executable file, default ./TUDPS_test
#
# runs a reduced set of 1UC instances with spinning-reserve requirements
#
# batch-reserve-red: reduced version of batch-reserve for quick checks.
# Runs only the first few units of each plan4res 1UC_TUB family (so both the
# primary-only and primary+secondary reserve cases, and both time horizons,
# are covered) with a single re-solve per instance, then the units with both
# reserves again with both of them rewarded.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../UCBlock/data/nc4/plan4res-data/1UC_TUB

TUDPS_test=${1:-./TUDPS_test}
par=BSCfg.txt

seed=0
wchg=135    # change fixed + linear + quadratic costs (+128: also regen the
            # abstract representation, exercising the Modification path)
rounds=1    # one solve per instance
nchg=10
pchg=0.6

PER_FAMILY=5

# the formulations of the unit are compared on each instance: it is read once
# per BlockConfig TUBCfg-<form>.txt that TUBForm-PC.txt lists, i.e., every
# formulation (3bin/T/pt/DP/SU/SD/SUSD) with the perspective cuts, each copy is
# solved by the same Solver, and the copies must agree with each other as the
# two Solver of each copy do. On the large-horizon families (L_B_C_26 /
# L_B_C_31, TimeHorizon 216) the interval-based formulations (pt/DP/SU/SD/SUSD)
# are too expensive, so there the list is TUBForm-PC-3bin-T.txt, which keeps
# only 3bin/T.
for fam in L_B_C_26 L_B_C_31 L_B_C_32 L_H_C_34; do
  case "$fam" in
    L_B_C_26|L_B_C_31) forms=TUBForm-PC-3bin-T.txt ;;
    *)                 forms=TUBForm-PC.txt ;;
  esac
  for f in $( ls "${DATADIR}"/${fam}_*.nc4 | head -n "${PER_FAMILY}" ); do
    run_test "$TUDPS_test" "$f" -S "$par" -e "$seed" -k "$wchg" \
        -F "$forms" -n "$rounds" -m "$nchg" -q "$pchg"
  done
done

# the units with both reserves, and the one of L_H_C_34 whose reserves are
# the largest fraction of its output, with both reserves rewarded
# (TUDPS_RESCOST), as when a Lagrangian dual prices the reserve requirements
for f in $( ls "${DATADIR}"/L_B_C_32_*.nc4 | head -n "${PER_FAMILY}" ) \
         $( ls "${DATADIR}"/L_H_C_34_*.nc4 | head -n "${PER_FAMILY}" ) \
         "${DATADIR}"/L_H_C_34_94.nc4; do
  TUDPS_RESCOST=-2 \
   run_test "$TUDPS_test" "$f" -S "$par" -e "$seed" -k "$wchg" \
       -F TUBForm-PC-3bin-T.txt -n "$rounds" -m "$nchg" -q "$pchg"
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
