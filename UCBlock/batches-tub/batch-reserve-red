#!/usr/bin/env bash
#
# usage: batch-reserve-red < exe file >
#        < exe file > = path of the executable file, default ./TUDPS_test
#
# runs a reduced set of 1UC instances with spinning-reserve requirements
#
# batch-reserve-red: reduced version of batch-reserve for quick checks.
# Runs only the first few units of each plan4res 1UC_TUB family (so both the
# primary-only and primary+secondary reserve cases, and both time horizons,
# are covered) with a single re-solve per instance.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../UCBlock/data/nc4/plan4res-data/1UC_TUB

TUDPS_test=${1:-./TUDPS_test}
par=BSCfg.txt

seed=0
wchg=135    # change fixed + linear + quadratic costs (+128: also regen the
            # abstract representation, exercising the Modification path)
rounds=1    # one solve per instance
nchg=10
pchg=0.6

PER_FAMILY=5

# the formulation of the unit is the BlockConfig TUBCfg-<form>.txt, one per
# formulation (3bin/T/pt/DP/SU/SD/SUSD), -PC adding the perspective cuts. We
# test every formulation with cuts. On the large-horizon families (L_B_C_26 /
# L_B_C_31, TimeHorizon 216) the interval-based formulations (pt/DP/SU/SD/SUSD)
# are too expensive, so we skip them and keep only 3bin/T.
for fam in L_B_C_26 L_B_C_31 L_B_C_32 L_H_C_34; do
  case "$fam" in L_B_C_26|L_B_C_31) big=1 ;; *) big=0 ;; esac
  for f in $( ls "${DATADIR}"/${fam}_*.nc4 | head -n "${PER_FAMILY}" ); do
    for form in 3bin-PC T-PC pt-PC DP-PC SU-PC SD-PC SUSD-PC; do
      # skip the expensive interval-based formulations on large instances
      if [ $form != 3bin-PC ] && [ $form != T-PC ] && [ "$big" = 1 ]; then
        continue
      fi
      run_test "$TUDPS_test" "$f" -S "$par" -e "$seed" -k "$wchg" -B "TUBCfg-$form.txt" -n "$rounds" -m "$nchg" -q "$pchg"
    done
  done
done

