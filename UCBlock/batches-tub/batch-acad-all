#!/usr/bin/env bash
#
# usage: batch-acad-all < exe file >
#        < exe file > = path of the executable file, default ./TUDPS_test
#
# runs all 1UC academic instances across thermal formulations

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../UCBlock/data/nc4/1UC_Data

wchg=135    # change fixed + linear + quadratic costs (+128: also regen the
            # abstract representation, exercising the Modification path)
#iter=0

TUDPS_test=${1:-./TUDPS_test}
par=BSCfg.txt

# ACAD + Lagrangian - - - - - - - - - - - - - - - - - - - -

# the formulation of the unit is the BlockConfig TUBCfg-<form>.txt, one per
# formulation (3bin/T/pt/DP/SU/SD/SUSD), -PC adding the perspective cuts. We
# test every formulation with cuts. The interval-based formulations
# (pt/DP/SU/SD/SUSD) are too expensive on large-horizon instances, so there we
# skip them and keep only 3bin/T.
for form in 3bin-PC T-PC pt-PC DP-PC SU-PC SD-PC SUSD-PC; do
  for i in 24 96; do
    # skip the expensive interval-based formulations on large instances
    if [ $form != 3bin-PC ] && [ $form != T-PC ] && [ $i -eq 96 ]; then
      continue
    fi
    for j in 1 12 16 23; do
      # in CI only 5 of the 100 ramp profiles are run (they are variations of
      # the same shape); the local sweep stays exhaustive
      if [ -n "$CI" ]; then hlist="1 25 50 75 100"; else hlist=$(seq 1 100); fi
      for h in $hlist; do
        #for (( seed = 0 ; seed < 20 ; seed++ )); do
          seed=0

          what=${DATADIR}/${i}/S${j}ramp${h}_${i}.nc4

          run_test "$TUDPS_test" "$what" -S "$par" -e "$seed" -k "$wchg" -B "TUBCfg-$form.txt" -n "$iter"

        #done
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
