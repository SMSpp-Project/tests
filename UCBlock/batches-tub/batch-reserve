#!/usr/bin/env bash
#
# usage: batch-reserve < exe file >
#        < exe file > = path of the executable file, default ./TUDPS_test
#
# runs the 1UC instances with spinning-reserve requirements
#
# batch-reserve: run TUDPS on the plan4res "1UC_TUB" single-unit instances.
#
# These are single ThermalUnitBlocks extracted from the L_B_C_26 / L_B_C_31 /
# L_B_C_32 / L_H_C_34 UCBlock instances; unlike the academic 1UC_Data ones,
# they carry primary and (for L_B_C_32 / L_H_C_34) secondary spinning-reserve
# data (PrimaryRho / SecondaryRho). The test enables the reserve variables via
# set_reserve_vars(3) and checks the DP solver against the MILP solver.
#
# Families and sizes:
#   L_B_C_26  TimeHorizon 216   151 units   (primary reserve)
#   L_B_C_31  TimeHorizon 216   151 units   (primary reserve)
#   L_B_C_32  TimeHorizon  24   114 units   (primary + secondary reserve)
#   L_H_C_34  TimeHorizon  24   978 units   (primary + secondary reserve)

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../UCBlock/data/nc4/plan4res-data/1UC_TUB

TUDPS_test=${1:-./TUDPS_test}
par=BSCfg.txt

seed=0
wchg=135    # change fixed + linear + quadratic costs (+128: also regen the
            # abstract representation, exercising the Modification path)
rounds=10   # re-solves per instance (exercises the Modification path)
nchg=10
pchg=0.6

# the formulations of the unit are compared on each instance: it is read once
# per BlockConfig TUBCfg-<form>.txt that TUBForm-PC.txt lists, i.e., every
# formulation (3bin/T/pt/DP/SU/SD/SUSD) with the perspective cuts, each copy is
# solved by the same Solver, and the copies must agree with each other as the
# two Solver of each copy do. On the large-horizon families (L_B_C_26 /
# L_B_C_31, TimeHorizon 216) the interval-based formulations (pt/DP/SU/SD/SUSD)
# are too expensive, so there the list is TUBForm-PC-3bin-T.txt, which keeps
# only 3bin/T.
# in CI one instance in 10 of each family is run: the whole of it takes more
# than an hour there, and the instances of a family are the same unit on
# different days
if [ -n "$CI" ]; then every=10; else every=1; fi

for fam in L_B_C_26 L_B_C_31 L_B_C_32 L_H_C_34; do
  case "$fam" in
    L_B_C_26|L_B_C_31) forms=TUBForm-PC-3bin-T.txt ;;
    *)                 forms=TUBForm-PC.txt ;;
  esac
  k=0
  for f in "${DATADIR}"/${fam}_*.nc4; do
    (( k++ % every )) && continue
    run_test "$TUDPS_test" "$f" -S "$par" -e "$seed" -k "$wchg" \
        -F "$forms" -n "$rounds" -m "$nchg" -q "$pchg"
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
