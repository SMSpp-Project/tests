#!/usr/bin/env bash
#
# usage: batch-acad-red < exe file >
#        < exe file > = path of the executable file, default ./TUDPS_test
#
# runs a reduced set of 1UC academic instances across thermal formulations

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../UCBlock/data/nc4/1UC_Data

wchg=133    # change fixed + quadratic costs (+128: also regen the abstract
            # representation, exercising the Modification path)
#iter=0

TUDPS_test=${1:-./TUDPS_test}
par=BSCfg.txt

# ACAD + Lagrangian - - - - - - - - - - - - - - - - - - - -

# the formulations of the unit are compared on each instance: it is read once
# per BlockConfig TUBCfg-<form>.txt that TUBForm-PC.txt lists, i.e., every
# formulation (3bin/T/pt/DP/SU/SD/SUSD) with the perspective cuts, each copy is
# solved by the same Solver, and the copies must agree with each other as the
# two Solver of each copy do. Only the short horizon is run here, hence the list
# is always the whole one.
i=24
j=1
# in CI only 5 of the 100 ramp profiles are run (they are variations of the
# same shape); the local sweep stays exhaustive
if [ -n "$CI" ]; then hlist="1 25 50 75 100"; else hlist=$(seq 1 100); fi
for h in $hlist; do
  # in CI a single seed is enough; the local sweep stays exhaustive
  if [ -n "$CI" ]; then slist="0"; else slist=$(seq 0 19); fi
  for seed in $slist; do

    what=${DATADIR}/${i}/S${j}ramp${h}_${i}.nc4

    run_test "$TUDPS_test" "$what" -S "$par" -e "$seed" -k "$wchg" \
        -F TUBForm-PC.txt -n "$iter"

  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
