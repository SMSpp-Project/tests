#!/usr/bin/env bash
#
# usage: batch-ec < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs all the deterministic energy community instances and checks that the
# EnergyCommunity.jl objective value matches the given reference one

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
DEFAULT_PAR=BSPar.txt
# the LagrangianDualRelaxationSolver of the BlockSolverConfig (the 4th
# Solver) is a relaxation: its upper bound is the other side of the
# relaxation, not of this problem, so it is declared one, and only its
# lower bound is held, to correctness alone [see BSPar.txt]
REL="${REL:-,,,r}"
EPS="${EPS:-,,,inf}"
parse_batch_args "$@"

# the formulations of the network, compared with each other on every
# instance [see InnerBForm-DCN.txt]; in CI only two of them
forms=InnerBForm-DCN.txt
[ -n "$CI" ] && forms=InnerBForm-DCN-CI.txt

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = | EnergyCommunity.jl objective value |
# (see more at https://github.com/SPSUnipi/EnergyCommunity.jl).
# The values come from the test harness in
# UCBlock/tools/csv2netCDF/test_instance_with_EC_jl.jl run as follows:
#   CO          --no-thermal  →  EC_CO_Test{,_NB}.nc4
#   CO          (no flag)     →  EC_CO_Test_TUB{,_NB}.nc4
#   CO          --no-asset    →  EC_NA_Test{,_NB}.nc4
#   NC          --no-thermal  →  EC_NC_Test{,_NB}.nc4
#   NC          (no flag)     →  EC_NC_Test_TUB{,_NB}.nc4
# (NA YAMLs were dropped in favor of CO + --no-asset, since they were
# identical to CO but with all installable assets disabled)
# --no-thermal / --no-asset fix the corresponding x_us decisions to 0
# in EnergyCommunity.jl, so the EC.jl model matches the SMS++ instance
# produced by csv2nc4.jl.

declare -A REF_OBJ

REF_OBJ[EC_CO_Test.nc4]=3.621281488e+06
REF_OBJ[EC_CO_Test_NB.nc4]=3.621281488e+06

REF_OBJ[EC_CO_Test_TUB.nc4]=3.547667838e+06
REF_OBJ[EC_CO_Test_TUB_NB.nc4]=3.547667838e+06

REF_OBJ[EC_NA_Test.nc4]=3.998662634e+06
REF_OBJ[EC_NA_Test_NB.nc4]=3.998662634e+06

REF_OBJ[EC_NC_Test.nc4]=3.775266685e+06
REF_OBJ[EC_NC_Test_NB.nc4]=3.775266685e+06

REF_OBJ[EC_NC_Test_TUB.nc4]=3.700178022e+06
REF_OBJ[EC_NC_Test_TUB_NB.nc4]=3.700178022e+06

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ../../UCBlock/data/nc4/EC_Data/ucblock/EC_CO_*.nc4 \
            ../../UCBlock/data/nc4/EC_Data/ucblock/EC_NA_*.nc4 \
            ../../UCBlock/data/nc4/EC_Data/ucblock/EC_NC_*.nc4; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    base=$(basename "$what")
    ref=${REF_OBJ[$base]}

    if [ -z "$ref" ]; then
      echo "No reference objective defined for file: $base"
      exit 1
    fi

    run_test "$exe" "$what" -S "$par" -R "$REL" -E "$EPS" -F "$forms" \
             -r "$ref"
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
