#!/usr/bin/env bash
#
# usage: batch-ac < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs the single-period AC OPF instances. ACNetworkBlock derives from
# DCNetworkBlock but entirely redefines its constraints with a convex
# relaxation of the AC model, by default the SOCP relaxation strengthened by
# the envelopes of the trigonometric terms (see the class description of
# ACNetworkBlock), so the DCNetworkBlock wf switch (PTDF/CYCLE/KIRCHHOFF) is
# bypassed: no wf loop here. All the Solver here solve the continuous
# relaxation (intRelaxIntVars 1), where the McCormick inequalities of the
# strengthening are not separated, so its value is that of the SOCP
# relaxation.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
DEFAULT_PAR=BSPar-AC.txt
# the LagrangianDualSolver here solves a relaxation, and the point it writes
# is a point of the relaxed problem: on a conic instance a convex combination
# of solutions of the sub-problems does not satisfy the quadratic constraints,
# so what that point is worth is not the bound the solver reports, above or
# below it indifferently. It is declared as such, so that it is held to
# solving its own problem exactly while of this one it only bounds the side
# a relaxation bounds
REL="${REL:-,r}"

parse_batch_args "$@"

# AC OPF relaxations, convex QCPs with second-order cones, are more
# degenerate than DC ones, so the default GRBMILPSolver settings can pick a
# different optimal point than the LagrangianDualSolver, producing a small
# gap between the exact Solver. BSPar-AC.txt, the default here, is the EASY
# variant (intDoEasy=0) with the reproducibility recipe applied (Method=2,
# Presolve=0, NumericFocus=3).

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/AC_Data

for what in ${DATADIR}/*.nc4; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    # skip the 24h instances: 1236 nodes x 1543 lines x 24 time steps give
    # 609573 rows and 177696 quadratic rows, all convex (GUROBI accepts the
    # continuous relaxation with NonConvex 0, 171096 second-order cones after
    # presolve). The :MILPSolver alone solves it by barrier in some 275 s,
    # 160 s with the plain SOCP relaxation (static variables 0 in the
    # BlockConfig of ACNetworkBlock), which has the same value (5.4553668e9
    # and 5.4553687e9 on c01, within the barrier tolerance); but the
    # Lagrangian chain, which needs QCPDual to get the duals of the quadratic
    # constraints at all [see LPBSCfg-QCP.txt], does not converge in 90
    # minutes even on the plain SOCP, stops a sub-problem on numerical
    # difficulties (GUROBI status 12) and exceeds the sessions of the GUROBI
    # license (error 10030) with its parallel sub-problems (dantzig, load
    # 200-270, 2026-10-11). Taking them would mean a time limit on the
    # LagrangianDualSolver and on the heuristic, or the :MILPSolver alone
    # with no cross-check: until that is decided, this batch stays on the
    # single-period benchmarks.
    case "$(basename "$what")" in
      *_24h_*) continue ;;
    esac

    run_test "$exe" "$what" -S "$par" -R "$REL" -B InnerBCfg.txt

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
