#!/usr/bin/env bash
#
# usage: batch-ac < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs the single-period AC OPF instances and a sample of those over 24
# hours. ACNetworkBlock derives from
# DCNetworkBlock but entirely redefines its constraints with a convex
# relaxation of the AC model, by default the SOCP relaxation strengthened by
# the envelopes of the trigonometric terms (see the class description of
# ACNetworkBlock), so the DCNetworkBlock wf switch (PTDF/CYCLE/KIRCHHOFF) is
# bypassed: no wf loop here. All the Solver here solve the continuous
# relaxation (intRelaxIntVars 1), where the McCormick inequalities of the
# strengthening are not separated, so its value is that of the SOCP
# relaxation.
#
# The verdict is not the same on the two sets. On the single-period
# instances every Solver solves its problem to optimality and the values
# have to agree (OK(f)). On those over 24 hours the LagrangianDualSolver
# stops after a number of iterations and the PrimalProximalHeur at a time
# limit [see BSPar-AC-24h.txt], and a
# Solver that is stopped owes only the consistency of its bounds: the lower
# bound of the LagrangianDualSolver (a relaxation, see REL below) not above
# the upper bound of the others, the bounds of the heuristic not across
# those of the :MILPSolver, which alone is held to its optimum; this is
# the criterion of cross_check() in common_utils.cpp for a Solver that does
# not return kOK, so the verdict of an instance over 24 hours says that the
# bounds are consistent, not that the values are equal.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
DEFAULT_PAR=BSPar-AC.txt
# the LagrangianDualSolver here solves a relaxation, and the point it writes
# is a point of the relaxed problem: on a conic instance a convex combination
# of solutions of the sub-problems does not satisfy the quadratic constraints,
# so what that point is worth is not the bound the solver reports, above or
# below it indifferently. It is declared as such, so that it is held to
# solving its own problem exactly while of this one it only bounds the side
# a relaxation bounds
REL="${REL:-,r}"

parse_batch_args "$@"

# AC OPF relaxations, convex QCPs with second-order cones, are more
# degenerate than DC ones, so the default GRBMILPSolver settings can pick a
# different optimal point than the LagrangianDualSolver, producing a small
# gap between the exact Solver. BSPar-AC.txt, the default here, is the EASY
# variant (intDoEasy=0) with the reproducibility recipe applied (Method=2,
# Presolve=0, NumericFocus=3).

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/AC_Data

for what in ${DATADIR}/*.nc4; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    # the 24h instances are run below, on a sample
    case "$(basename "$what")" in
      *_24h_*) continue ;;
    esac

    run_test "$exe" "$what" -S "$par" -R "$REL" -B InnerBCfg.txt

done

# a sample of the instances over 24 hours - - - - - - - - - - - - - - - - - -
# The 53 instances ES_acopf_srd_id_*_24h_1 are the same grid (1236 nodes,
# 1543 lines) with the same units (153 ThermalUnitBlock, 777
# IntermittentUnitBlock, 37 HydroUnitBlock, 15 BatteryUnitBlock): they only
# differ in the demand, of two days (a total of 731536 to 737451 for the
# first, 694686 to 699517 for d2) and of the cases c00-c23, da, g1 and g2.
# The sample has both days, the largest and the smallest total demand of
# each (g2 and c14, d2_c03 and d2_c12), the family da and c01. Each is
# 439221 rows and 111024 quadratic rows, all convex, with the SOCP
# relaxation [see InnerBCfg-SOCP.txt], which in a continuous solve has the
# value of the strengthened one with some 30% fewer rows. On them the
# :MILPSolver takes 95-135 s, the LagrangianDualSolver stops after its 15
# iterations in 145-250 s with a lower bound 0.19% (first day) to 0.7% (d2)
# below the optimum, and the PrimalProximalHeur stops at its time limit, in
# some 485 s, with that bound and no feasible solution; with the 4
# single-period instances the batch takes 81 minutes, all OK(f) (dantzig,
# load 210-350, 2026-10-12). The other 47 are skipped, and in CI the sample
# too: each instance takes some 8 minutes and more memory than a runner has.

sample="c01 c14 da g2 d2_c03 d2_c12"
if [ -n "$CI" ]; then sample=""; fi

for case in $sample; do
    what=${DATADIR}/ES_acopf_srd_id_${case}_24h_1.nc4
    if [ ! -f "$what" ]; then
      continue
    fi
    run_test "$exe" "$what" -S BSPar-AC-24h.txt -R "$REL" \
             -B InnerBCfg-SOCP.txt
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
