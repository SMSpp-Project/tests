#!/usr/bin/env bash
#
# usage: batch-ac < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs all the AC OPF instances. ACNetworkBlock derives from DCNetworkBlock
# but entirely redefines its constraints with the SOCP relaxation (see
# ACNetworkBlock.cpp: "do not call DCNetworkBlock::generate_abstract_constraints
# ...the class entirely redefines its constraints"), so the DCNetworkBlock
# wf switch (PTDF/CYCLE/KIRCHHOFF) is bypassed: no wf loop here.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
DEFAULT_PAR=BSPar-AC.txt
# the accuracy each Solver is held to is the dblRelAcc of its ComputeConfig,
# except for the PrimalProximalHeur: what is asked of the inner BundleSolver
# is not what its primal solution is worth, so the third field of -E declares
# the quality of its upper bound on these instances, where it closes
# the gap almost exactly (measured worst case: 2.3e-07)
EPS="${EPS:-,,1e-4}"
parse_batch_args "$@"

# AC OPF LP relaxations are more degenerate than DC ones (SOCP cone +
# McCormick envelopes), so the default GRBMILPSolver settings can pick a
# different optimal vertex than the LagrangianDualSolver, producing a small
# gap between the exact Solver. BSPar-AC.txt, the default here, is the EASY
# variant (intDoEasy=0) with the LP-reproducibility recipe applied (Method=1,
# Presolve=0, NumericFocus=3).

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

DATADIR=../../UCBlock/data/nc4/AC_Data

for what in ${DATADIR}/*.nc4; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    # skip 24h temporal instances: 1236 nodes x 1543 lines x 24 time steps
    # produces ~500k SOCP constraints and the run does not complete in any
    # reasonable test timeout. Pending a performance investigation, restrict
    # this batch to single-period AC OPF benchmarks.
    case "$(basename "$what")" in
      *_24h_*) continue ;;
    esac

    run_test "$exe" "$what" -S "$par" -B InnerBCfg.txt -E "$EPS"

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
