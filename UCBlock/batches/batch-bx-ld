#!/usr/bin/env bash
# Run a small UCBlock subset with BranchAndXSolver driven by
# LagrangianDualRelaxationSolver.

source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
DEFAULT_PAR=BSPar-BX-LD.txt
parse_batch_args "$@"

DATADIR=../../UCBlock/data/nc4/UC_Data/T-Ramp

# in CI the units of size 20 are not run: the four instances take more than
# the hour a test is given there, the two of size 20 alone most of it
if [ -n "$CI" ]; then sizes=10; else sizes="10 20"; fi

for size in $sizes; do
  for seed in 1 2; do
    run_test "$exe" "${DATADIR}/${size}_0_${seed}_w.nc4" \
      -S "$par" -B InnerBCfg.txt
  done
done