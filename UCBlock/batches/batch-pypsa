#!/usr/bin/env bash
#
# usage: batch-pypsa < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs all the PyPSA instances and checks that the PyPsa objective value
# matches the given reference one; those of 3n_3c_1gext_1h_1bext_2l whose
# name ends with a limit (e.g., _co2_50) have the global constraints of the
# PyPsa network on the dispatch, translated by pypsa2smspp into the pollutant
# budget constraints of UCBlock: a CO2 limit twice and half the emissions of
# the unconstrained dispatch, a CO2 and a NOx limit, a CO2 floor, a CO2
# equality, an operational limit on a carrier, and CO2 limits where a store
# and a hydro storage unit contribute through their final level (the
# instances are written by test/pollutant_generator.py of pypsa2smspp)

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
# all the PyPSA instances are pure-LD subproblems on a single
# ECNetworkBlock-like component: BundleSolver requires intDoEasy=0, so the
# EASY variant is the default here (the standard BSPar.txt, intDoEasy=1,
# would raise "BundleSolver: all components are easy, this is no supported").
DEFAULT_PAR=BSPar-EASY.txt
parse_batch_args "$@"

# of the three Solver of BSPar-EASY.txt only the first one, the MILP,
# answers this problem: the LagrangianDualSolver solves its dual, and the
# PrimalProximalHeur the same dual with a primal recovery on top, so both
# are declared relaxations and held to bounding the side a relaxation
# bounds, rather than to a value and to an upper bound they need not have
REL="${REL:-,r,r}"

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = PyPsa objective value

declare -A REF_OBJ

REF_OBJ[smspp_1n_1c_1g.nc]=4.221761376e+09
REF_OBJ[smspp_1n_1c_1g_1h.nc]=4.984288994e+08
REF_OBJ[smspp_1n_1c_1gext.nc]=4.055269613e+09
REF_OBJ[smspp_2n_1c_1g_1b.nc]=3.944062665e+09
REF_OBJ[smspp_2n_1c_1gext_1bext_2l.nc]=3.887187461e+09
# this one is the optimum SMS++ computes and not the PyPsa value: on
# this instance alone the two disagree by some 1e-5 relative, where
# everywhere else they agree to the last digit
REF_OBJ[smspp_2n_1c_1gext_1bext_2lext.nc]=7.034812177e+08
REF_OBJ[smspp_2n_2c_1g_1lext.nc]=6.720604306e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l.nc]=2.907246492e+09
REF_OBJ[smspp_3n_3c_2gext_1l_1ml.nc]=1.302415551e+10
REF_OBJ[smspp_3n_3c_2gext_1lext_1mlext.nc]=1.147874238e+07
REF_OBJ[smspp_sector_1n_1cn_1gn.nc]=-6.883586038e+04
REF_OBJ[smspp_sector_1n_1cn_1gnext.nc]=2.399258678e+05

# the instances with pollutant budget constraints
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_200.nc]=1.671547247e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_50.nc]=6.751130209e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_nox.nc]=5.293804195e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_min.nc]=1.807113140e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_ccgt_limit.nc]=6.513045862e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_h2.nc]=6.833593826e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_eq.nc]=2.273162064e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_hydro.nc]=8.196633457e+10

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for wf in 0 1 2; do

    for what in ../../UCBlock/data/nc4/pypsa-data/smspp_*.nc; do

        # skip if pattern did not match any file
        if [ ! -f "$what" ]; then
          continue
        fi

        base=$(basename "$what")

        ref=${REF_OBJ[$base]}

        if [ -z "$ref" ]; then
          echo "No reference objective defined for file: $base"
          exit 1
        fi

        run_test "$exe" "$what" -S "$par" -R "$REL" -B InnerBCfg.txt \
                 -r "$ref" -f "$wf"

    done

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
