#!/usr/bin/env bash
#
# usage: batch-pypsa < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs all the PyPSA instances of pypsa-data/ucblock and pypsa-data/pollutants
# and checks that the PyPsa objective value matches the given reference one;
# those in pypsa-data/pollutants are 3n_3c_1gext_1h_1bext_2l with the global
# constraints of the PyPsa network on the dispatch, translated by pypsa2smspp
# into the pollutant budget constraints of UCBlock: a CO2 limit twice and half
# the emissions of the unconstrained dispatch, a CO2 and a NOx limit, a CO2
# floor, a CO2 equality, an operational limit on a carrier, and CO2 limits
# where a store and a hydro storage unit contribute through their final level
# (the instances are written by test/pollutant_generator.py of pypsa2smspp)

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
# all the PyPSA instances are pure-LD subproblems on a single
# ECNetworkBlock-like component: BundleSolver requires intDoEasy=0, so the
# EASY variant is the default here (the standard BSPar.txt, intDoEasy=1,
# would raise "BundleSolver: all components are easy, this is no supported"),
# with the one parameter of the Bundle these instances need changed, the
# threshold under which the norm of the residual is taken to be zero
# [see BSPar-PYPSA.txt]
DEFAULT_PAR=BSPar-PYPSA.txt
parse_batch_args "$@"

# of the three Solver of BSPar-PYPSA.txt only the first one, the MILP,
# answers this problem: the LagrangianDualSolver solves its dual, and the
# PrimalProximalHeur the same dual with a primal recovery on top, so both
# are declared relaxations and held to bounding the side a relaxation
# bounds, rather than to a value and to an upper bound they need not have
REL="${REL:-,r,r}"

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = PyPsa objective value

declare -A REF_OBJ

REF_OBJ[smspp_1n_1c_1g.nc]=1.517348289e+11
REF_OBJ[smspp_1n_1c_1g_1h.nc]=2.793939844e+10
REF_OBJ[smspp_1n_1c_1gext.nc]=1.447274894e+11
REF_OBJ[smspp_2n_1c_1g_1b_2l.nc]=1.476439209e+11
REF_OBJ[smspp_2n_1c_1gext_1bext_2l.nc]=1.435139638e+11
REF_OBJ[smspp_2n_1c_1gext_1bext_2lext.nc]=3.050227529e+10
REF_OBJ[smspp_2n_2c_1g_1lext.nc]=2.446649078e+11
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l.nc]=1.501972958e+09
REF_OBJ[smspp_3n_3c_2gext_1l_1ml.nc]=4.736469299e+11
REF_OBJ[smspp_3n_3c_2gext_1lext_1mlext.nc]=1.495190064e+07
REF_OBJ[smspp_sector_1n_1cn_1gn.nc]=-2.400702717e+07
REF_OBJ[smspp_sector_1n_1cn_1gnext.nc]=-2.372297229e+07
REF_OBJ[smspp_tssb_2n_2gext_1l.nc]=1.508768621e+09

# the instances with pollutant budget constraints
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_200.nc]=1.501972958e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_50.nc]=6.679866968e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_nox.nc]=5.233050238e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_min.nc]=1.572466474e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_ccgt_limit.nc]=6.679866968e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_h2.nc]=6.679866968e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_eq.nc]=2.339416779e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_hydro.nc]=7.898750861e+10

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for wf in 0 1 2; do

    for what in ../../UCBlock/data/nc4/pypsa-data/ucblock/smspp_*.nc \
                ../../UCBlock/data/nc4/pypsa-data/pollutants/smspp_*.nc; do

        # skip if pattern did not match any file
        if [ ! -f "$what" ]; then
          continue
        fi

        base=$(basename "$what")

        ref=${REF_OBJ[$base]}

        if [ -z "$ref" ]; then
          echo "No reference objective defined for file: $base"
          exit 1
        fi

        run_test "$exe" "$what" -S "$par" -R "$REL" \
                 -B InnerBCfg.txt -r "$ref" -f "$wf"

    done

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
