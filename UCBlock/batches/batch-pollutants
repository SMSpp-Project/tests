#!/usr/bin/env bash
#
# usage: batch-pollutants < exe file > < par file > < log file >
#        < exe file > = path of the executable file, default UCBlock_test
#        < par file > = BlockSolverConfig file, default BSPar-EASY.txt
#        < log file > = name of log file, default no log
#
# runs the PyPSA instances with pollutant budget constraints, i.e., the
# global constraints of the PyPsa network on the dispatch translated by
# pypsa2smspp, and checks that the PyPsa objective value matches the given
# reference one: a CO2 limit twice and half the emissions of the unconstrained
# dispatch, a CO2 and a NOx limit, a CO2 floor (a lower bound), an
# operational limit on a carrier, and a CO2 limit where a store contributes
# through its final level; the instances are written by
# pollutant_generator.py of pypsa2smspp

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./UCBlock_test
# as in batch-pypsa, these are pure-LD subproblems: BundleSolver requires
# intDoEasy=0, hence the EASY variant
DEFAULT_PAR=BSPar-EASY.txt

parse_batch_args "$@"

# as in batch-pypsa, only the MILP answers the problem, the other two
# Solver are relaxations
REL="${REL:-,r,r}"

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = PyPsa objective value

declare -A REF_OBJ

REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_200.nc]=1.614054032e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_50.nc]=6.577283237e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_nox.nc]=5.674789164e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_min.nc]=1.595084457e+09
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_ccgt_limit.nc]=7.041837002e+10
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l_co2_h2.nc]=6.258806398e+10

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for wf in 0 1 2; do

    for what in ../../UCBlock/data/nc4/pypsa-data/pollutants/smspp_*.nc; do

        # skip if pattern did not match any file
        if [ ! -f "$what" ]; then
          continue
        fi

        base=$(basename "$what")

        ref=${REF_OBJ[$base]}

        if [ -z "$ref" ]; then
          echo "No reference objective defined for file: $base"
          exit 1
        fi

        run_test "$exe" "$what" -S "$par" -R "$REL" -B InnerBCfg.txt \
                 -r "$ref" -f "$wf"

    done

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
