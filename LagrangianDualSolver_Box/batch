#!/usr/bin/env bash
#
# usage: batch < exe file > < par file >
#        < exe file > = path of the executable file, default ./LDS_Box_test
#        < par file >  = BlockSolverConfig file, default BSPar.txt
#
# runs the tests with LagrangianDualSolver over a range of sizes, number of
# sub-blocks, densities and seeds

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../batch_common.sh"

what=15
#iter=10

LDS_Box_test=${1:-./LDS_Box_test}
par=${2:-BSPar.txt}

#for nvar in 2 10 50 100
for nvar in 2 10 50; do
  for nson in 2 9 20; do
    for dens in 0.05 0.1; do
      for (( seed = 7 ; seed < 13 ; seed++ )); do

        # ordinarily one would stop with any error, but experience shows that
        # a few errors arise from numerical difficulties in Cplex, which is
        # why we print stuff in the tester but leave the batch running
        run_test "$LDS_Box_test" -S "$par" -e "$seed" -k "$what" -N "$nvar" -s "$nson" -d "$dens" -n "$iter"

      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
