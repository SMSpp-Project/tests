#!/usr/bin/env bash
#
# usage: batch < exe file >
#        < exe file > = path of the executable file, default ./writeandread_test
#
# writes each generated Block to file and reads it back, checking the
# round-trip over a range of sizes, densities and seeds

what=31
#what=1
#iter=10

writeandread_test=${1:-./writeandread_test}

# shared CLI/run helpers (print_header, run_test)
source "$(dirname "$0")/../batch_common.sh"

#for size in 2 10 50 100
for size in 2 10 50; do
  for dens in 3 1.1; do
    for (( seed = 0 ; seed < 20 ; seed++ )); do

      # run_test prints the "[<args>]:" header and exits on failure; an empty
      # $iter simply collapses, matching the previous label
      run_test "$writeandread_test" $seed $what $size $dens $iter

    done
  done
done

