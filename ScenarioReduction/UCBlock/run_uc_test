#!/usr/bin/env bash
#
# usage: run_uc_test [ options ]
#        --generator < path >   scenario generator, default ./UCScenarioGenerator
#        --solve < path >       reduction test, default ./ScenarioReductionSolver_test
#        --instances < list >   instance names or paths, default EC_CO_Test_TUB
#        --n < list >           scenario counts N, default 25
#        --k < list >           representative counts K, default 5
#        --seeds < list >       random seeds, default 10
#        --methods < list >     reduction methods, default cssc
#        --solver < file >      BlockSolverConfig, default BSCfg.txt
#        --variation < x >      data variation, default 0.5
#        --uncertainty < w >    demand | renewable | both, default demand
#        --instance-dir < dir > where the UC instances are searched
#        --scenario-dir < dir > where the generated scenarios are written
#        --config-dir < dir >   where the BSCfg.txt configs live
#        --output < file >      CSV results file
#
# generates the scenarios and the TSSB file for each instance, N and seed,
# then reduces and solves it for each K and each method, reporting the gap
# between the reduced problem and the full one; see README.md.
#
# The two executables live in the build tree, hence they are given from the
# outside, defaulting to the current directory as every other SMS++ batch;
# everything else defaults to a path relative to this script, so that the
# batch runs from any working directory and against any build tree.

set -u

HERE="$( cd "$( dirname "$0" )" && pwd )"

GEN="${GEN:-./UCScenarioGenerator}"
SOLVE="${SOLVE:-./ScenarioReductionSolver_test}"
IDIR="${IDIR:-${HERE}/../../../UCBlock/data/nc4}"
SDIR="${SDIR:-${TMPDIR:-/tmp}/uc_scenarios}"
CFGDIR="${CFGDIR:-${HERE}/..}"   # where the BSCfg.txt configs live

INSTANCES="EC_CO_Test_TUB"
N_VALUES="25"
K_VALUES="5"
SEEDS="10"
METHODS="cssc"
SOLVER=BSCfg.txt                 # bare name (looked up in CFGDIR) or a full path
VARIATION="0.5"
UNCERTAINTY="demand"                  # demand | renewable | both
OUTPUT_CSV="uc_results_seed_20.csv"

# ---- parse flags ----------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --generator)    GEN="$2";         shift 2 ;;
        --solve)        SOLVE="$2";       shift 2 ;;
        --instances)    INSTANCES="$2";   shift 2 ;;
        --n)            N_VALUES="$2";    shift 2 ;;
        --k)            K_VALUES="$2";    shift 2 ;;
        --seeds)        SEEDS="$2";       shift 2 ;;
        --methods)      METHODS="$2";     shift 2 ;;
        --solver)       SOLVER="$2";      shift 2 ;;
        --variation)    VARIATION="$2";   shift 2 ;;
        --uncertainty)  UNCERTAINTY="$2"; shift 2 ;;
        --instance-dir) IDIR="$2";        shift 2 ;;
        --scenario-dir) SDIR="$2";        shift 2 ;;
        --config-dir)   CFGDIR="$2";      shift 2 ;;
        --output)       OUTPUT_CSV="$2";  shift 2 ;;
        -h|--help)      grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

[ ! -x "$GEN" ] && {
    echo "ERROR: $GEN not found (build UCScenarioGenerator, or pass"
    echo "       --generator < path >)"; exit 1; }
[ ! -x "$SOLVE" ] && {
    echo "ERROR: $SOLVE not found (build ScenarioReductionSolver_test, or"
    echo "       pass --solve < path >)"; exit 1; }
[ ! -d "$IDIR" ] && {
    echo "ERROR: instance directory not found: $IDIR"; exit 1; }

# allow a bare filename for solver (e.g. BSCfg.txt): resolve under CFGDIR.
# A value containing a slash is treated as a path and used as is.
[[ "$SOLVER" != */* ]] && SOLVER="$CFGDIR/$SOLVER"
[ ! -f "$SOLVER" ] && { echo "ERROR: solver config not found: $SOLVER"; exit 1; }

# map uncertainty -> generator flag
case "$UNCERTAINTY" in
    demand)    GEN_FLAG="--no-maxpower" ;;   # only demand varies (renewable off)
    renewable) GEN_FLAG="--no-demand"   ;;   # only renewable varies (demand off)
    both)      GEN_FLAG=""              ;;
    *) echo "ERROR: --uncertainty must be demand|renewable|both"; exit 1 ;;
esac

mkdir -p "$SDIR"

echo "Instance,Uncertainty,Seed,N,K,Method,Full_Obj,Reduced_Obj,Gap_Pct,RedTime_s,AlgoTime_s" > "$OUTPUT_CSV"
printf "\n%-16s %-10s %-5s %-4s %-3s %-9s %15s %15s %9s %11s %11s\n" \
    "Instance" "Uncert" "Seed" "N" "K" "Method" "Full_Obj" "Reduced_Obj" "Gap(%)" "RedTime(s)" "AlgoTime(s)"
printf '%.0s=' {1..118}; printf "\n"

for INST in $INSTANCES; do
    # resolve instance path (full path, or short name searched under IDIR)
    if [ -f "$INST" ]; then
        IPATH="$INST"
    else
        IPATH=$(find "$IDIR" -name "${INST}.nc4" 2>/dev/null | head -1)
    fi
    [ -z "$IPATH" ] && { echo "  skip: instance '$INST' not found under $IDIR"; continue; }

    for SEED in $SEEDS; do
        for N in $N_VALUES; do
            # one TSSB file per (instance, uncertainty, N, seed, variation)
            TSSB="$SDIR/${INST}_${UNCERTAINTY}_n${N}_s${SEED}_v${VARIATION}_tssb.nc4"
            if [ ! -f "$TSSB" ]; then
                "$GEN" -i "$IPATH" -o "$SDIR/${INST}_${UNCERTAINTY}_n${N}_s${SEED}_v${VARIATION}.nc4" \
                       --tssb-output "$TSSB" \
                       -n "$N" -v "$VARIATION" -s "$SEED" \
                       $GEN_FLAG --no-validate --verbose 0 >/dev/null 2>&1
            fi
            [ ! -f "$TSSB" ] && { echo "  skip: TSSB gen failed ($INST N=$N seed=$SEED)"; continue; }

            for K in $K_VALUES; do
                [ "$K" -ge "$N" ] && continue
                for M in $METHODS; do
                    OUT=$("$SOLVE" -i "$TSSB" -r "$K" -m "$M" -c "$SOLVER" 2>&1)

                    FULL=$(echo "$OUT" | grep -oP 'Full\s+\(N=[0-9]+\):\s*\K[0-9.eE+-]+' | head -1)
                    RED=$( echo "$OUT" | grep -oP 'Reduced \(K=[0-9]+\):\s*\K[0-9.eE+-]+' | head -1)
                    GAP=$( echo "$OUT" | grep -oP 'Gap:\s*\K[0-9.eE+-]+'                  | head -1)
                    RTIME_MS=$(echo "$OUT" | grep -oP 'Reduced \(K=[0-9]+\):[^(]*\(\K[0-9.]+(?=\s*ms\))' | head -1)
                    : ${FULL:=NA}; : ${RED:=NA}; : ${GAP:=NA}

                    # RedTime_s/AlgoTime_s: the generic solver only reports one
                    # timing (the reduction step itself, in ms); kept in both
                    # columns for CSV-format compatibility with old runs.
                    if [ -n "${RTIME_MS:-}" ]; then
                        RTIME=$(awk -v ms="$RTIME_MS" 'BEGIN{printf "%.3f", ms/1000}')
                    else
                        RTIME=NA
                    fi
                    ALGOTIME="$RTIME"

                    printf "%-16s %-10s %-5s %-4s %-3s %-9s %15s %15s %9s %11s %11s\n" \
                        "$INST" "$UNCERTAINTY" "$SEED" "$N" "$K" "$M" "$FULL" "$RED" "$GAP" "$RTIME" "$ALGOTIME"
                    echo "$INST,$UNCERTAINTY,$SEED,$N,$K,$M,$FULL,$RED,$GAP,$RTIME,$ALGOTIME" >> "$OUTPUT_CSV"
                done
            done
        done
    done
done

printf '%.0s=' {1..118}; printf "\n"
echo "CSV saved to: $OUTPUT_CSV"
