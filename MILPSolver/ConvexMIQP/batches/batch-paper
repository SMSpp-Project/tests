#!/usr/bin/env bash
#
# usage: batch-paper < exe file > < par file > < log file >
#        < exe file > = path of the executable, default
#                       MILPSolver_ConvexMIQP_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# Cross-check on the random convex MIQPs of section 4 of the paper of
# FAST-QPA, with both kinds of rows, at the four fractions of integer
# variables of the paper and at small sizes, three seeds each: every Solver
# of BSPar.txt must give the same optimum, which is not known beforehand,
# or say that the instance is infeasible, as one with rows of the first kind
# can be.

# run from the test directory so the tester reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../../batch_common.sh"

DEFAULT_EXE=./MILPSolver_ConvexMIQP_test
DEFAULT_PAR=BSPar.txt
parse_batch_args "$@"

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

sweep t "0 1" i "0.25 0.5 0.75 1" n "10 20 30" m "1 5 10" e "0 1 2" -- \
  eval 'run_test "$exe" -S "$par" -t "$t" -i "$i" -n "$n" -m "$m" -e "$e"'

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
