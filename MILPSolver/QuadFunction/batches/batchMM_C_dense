#!/usr/bin/env bash
#
# usage: batchMM_C_dense < exe file >
#        < exe file > = path of the executable file, default ./MILPSolver_QuadFunction_test
#
# runs MILPSolver_QuadFunction_test with the dense QP :MILPSolver of
# LPPar_CL_C-dense.txt (DAQPMILPSolver, QPOASESMILPSolver, ProxQPMILPSolver,
# QPMADMILPSolver, QuadProgMILPSolver, HPIPMMILPSolver) over the problems of
# the dense subset of the Maros-Meszaros test set of maros_meszaros_qpbenchmark
# (at most 1000 variables and 1000 constraints), written as LP files by
# qpb2lp.py; PRIMALC8, QADLITTL, QAFIRO, QBANDM, QBEACONF, QBORE3D, QBRANDY,
# QE226, QFORPLAN, QGROW15, QGROW7, QISRAEL, QPCBOEI1, QPCBOEI2, QRECIPE,
# QSCFXM1, QSCORPIO and QSHARE1B are left out: on these models, nearly LPs, the
# Hessian regularized by 1e-6 moves the optimum of QPMADMILPSolver and
# QuadProgMILPSolver by up to 3%, or their dual method declares them infeasible
# or fails; ProxQPMILPSolver declares QFORPLAN infeasible, DAQPMILPSolver
# does not end QSCFXM1, and HPIPMMILPSolver returns an error on QRECIPE and
# QSCFXM1

# the common part, which reads the argument [see qf_battery.sh]
source "$(dirname "$0")/qf_battery.sh" "$@"

qf_run_list C LPPar_CL_C-dense.txt \
  ./MarosMeszaros/CVXQP1_S.lp ./MarosMeszaros/CVXQP2_S.lp \
  ./MarosMeszaros/CVXQP3_S.lp ./MarosMeszaros/DPKLO1.lp \
  ./MarosMeszaros/DUAL1.lp ./MarosMeszaros/DUAL2.lp ./MarosMeszaros/DUAL3.lp \
  ./MarosMeszaros/DUAL4.lp ./MarosMeszaros/DUALC1.lp \
  ./MarosMeszaros/DUALC2.lp ./MarosMeszaros/DUALC5.lp \
  ./MarosMeszaros/DUALC8.lp ./MarosMeszaros/GENHS28.lp \
  ./MarosMeszaros/HS118.lp ./MarosMeszaros/HS21.lp ./MarosMeszaros/HS268.lp \
  ./MarosMeszaros/HS35.lp ./MarosMeszaros/HS35MOD.lp ./MarosMeszaros/HS51.lp \
  ./MarosMeszaros/HS52.lp ./MarosMeszaros/HS53.lp ./MarosMeszaros/HS76.lp \
  ./MarosMeszaros/LOTSCHD.lp ./MarosMeszaros/PRIMAL1.lp \
  ./MarosMeszaros/PRIMAL2.lp ./MarosMeszaros/PRIMAL3.lp \
  ./MarosMeszaros/PRIMALC1.lp ./MarosMeszaros/PRIMALC2.lp \
  ./MarosMeszaros/PRIMALC5.lp ./MarosMeszaros/QCAPRI.lp \
  ./MarosMeszaros/QPCBLEND.lp ./MarosMeszaros/QPCSTAIR.lp \
  ./MarosMeszaros/QPTEST.lp ./MarosMeszaros/QSC205.lp \
  ./MarosMeszaros/QSCAGR25.lp ./MarosMeszaros/QSCAGR7.lp \
  ./MarosMeszaros/QSCSD1.lp ./MarosMeszaros/QSCTAP1.lp \
  ./MarosMeszaros/QSHARE2B.lp ./MarosMeszaros/QSTAIR.lp \
  ./MarosMeszaros/S268.lp ./MarosMeszaros/TAME.lp \
  ./MarosMeszaros/ZECEVIC2.lp

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
