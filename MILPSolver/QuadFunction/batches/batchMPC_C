#!/usr/bin/env bash
#
# usage: batchMPC_C < exe file >
#        < exe file > = path of the executable file, default ./MILPSolver_QuadFunction_test
#
# runs MILPSolver_QuadFunction_test with the :MILPSolver for convex QPs of
# LPPar_CL_C.txt (SCIPMILPSolver, MOSEKMILPSolver, ClarabelMILPSolver,
# PIQPMILPSolver, OSQPMILPSolver) over the 64 problems of model predictive
# control in robotics of mpc_qpbenchmark, written as LP files by qpb2lp.py

# the common part, which reads the argument [see qf_battery.sh]
source "$(dirname "$0")/qf_battery.sh" "$@"

qf_run_list C LPPar_CL_C.txt ./MPC/*.lp

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
