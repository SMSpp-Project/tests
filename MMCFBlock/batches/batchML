#!/usr/bin/env bash
#
# usage: batchML < exe file >
#        < exe file > = path of the executable file, default ./MMCFBlock_test
#
# runs the Canad MMCF instances through LagrangianDualSolver with the ML-based
# step-size heuristic of BundleSolverML (the inner Solver is configured by
# BSPar-ML.txt with intMLTrainOnline / intNTrainRounds). It uses the same
# (flow) relaxation as the non-ML batches (-B BPar.txt), so the Lagrangian
# dual bound matches the :MILPSolver reference and the comparison passes.
#
# Requires Torch: BundleSolverML is only registered in the Solver factory when
# BundleSolver is built with Torch, so this batch fails (unknown Solver name)
# on a Torch-less build.

# the common part, which reads the argument [see mmcf_battery.sh]
source "$(dirname "$0")/mmcf_battery.sh" "$@"

# Canad - - - - - - - - - - - - - - - - - - - -

mmcf_canad BPar.txt BSPar-ML.txt

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
