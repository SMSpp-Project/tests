#!/usr/bin/env bash
#
# usage: batch < exe file > < log file >
#        < exe file > = path of the executable file, default ./SVM_test
#        < log file > = output log file (no log if absent)
#
# sweeps every formulation of the training problem, for both the classifier
# and the regression, cross-checking the Solver of the BlockSolverConfig on
# each of them

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./SVM_test
parse_batch_args "$@"

# wf is bit-wise: bits 0-1 select the formulation (0 Wolfe dual, 1 primal, 2
# decomposed; 3 is not a formulation), +4 penalises the training errors
# quadratically, +8 regularises the bias. The primal formulations only exist
# for the linear kernel, which is what this batch uses, so every combination
# below is admissible.
for form in 0 1 2; do
  for extra in 0 4 8 12; do

  wf=$(( form + extra ))

  # the decomposed formulation is the only one a Lagrangian Solver can attack,
  # so it is the only one whose BlockSolverConfig has one
  if [ ${form} -eq 2 ]; then
    par=BSPar-LD.txt
  else
    par=BSPar.txt
  fi

  for task in "" "-g"; do
    for N in 30 60; do
      for (( seed = 1 ; seed < 4 ; seed++ )); do

        run_test "$exe" -S "$par" -f "$wf" -N "$N" -M 4 -s 3 -n 1 \
                 -e "$seed" $task

      done
    done
  done

  done
done

