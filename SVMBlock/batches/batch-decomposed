#!/usr/bin/env bash
#
# usage: batch-decomposed < exe file > < log file >
#        < exe file > = path of the executable file, default ./SVM_test
#        < log file > = output log file (no log if absent)
#
# sweeps the number of chunks of the decomposed formulation, which is the one
# LagrangianDualSolver attacks by relaxing the consensus constraints: the more
# the chunks, the smaller each subproblem and the more the multipliers, so
# this is where the Lagrangian bound is checked to close on the optimum of the
# training problem whatever the granularity of the decomposition

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./SVM_test
DEFAULT_PAR=BSPar-LD.txt
parse_batch_args "$@"

# Each chunk carries 1/P of the regularisation term together with the loss of
# its own samples, so the finer the decomposition the flatter each subproblem:
# below a handful of samples per chunk the subproblems become nearly linear,
# the Lagrangian function very nonsmooth and the bundle breaks down, which is
# a regime of no practical interest and is deliberately not exercised. With
# N = 60 samples the sweep therefore stops at 15 chunks, i.e. 4 samples each.
# In CI only the coarser (and much faster) granularities are run.
if [ -n "$CI" ]; then slist="2 3 5"; else slist="2 3 5 10 15"; fi

for s in ${slist}; do

  # wf: the decomposed formulation (2), with the linear (0) or the quadratic
  # (+4) penalty of the training errors, and with the bias free (0) or
  # regularised (+8)
  for wf in 2 6 10 14; do
    for task in "" "-g"; do

      run_test "$exe" -S "$par" -f "$wf" -s "$s" \
               -N 60 -M 4 -C 1 -n 1 -e 1 $task

    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
