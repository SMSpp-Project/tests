#!/usr/bin/env bash
#
# usage: batch < ib exe > < sddp exe > < python > < log file >
#        < ib exe >   = path of investmentblock_solver, default
#                       ./investmentblock_solver
#        < sddp exe > = path of sddp_solver, default ./sddp_solver
#        < python >   = Python interpreter, default python3
#        < log file > = name of log file, default no log
#
# compares, at a fixed design, the value of an InvestmentFunction whose inner
# Block is an SDDPBlock, i.e., the mean of the costs of the simulations that
# its SDDPGreedySolver runs after the training, with the simulations of the
# same SDDPBlock by sddp_solver -s, one per scenario, after the training by
# sddp_solver, and the latter with the value by hand. Both tools pass the
# state of a thermal unit from a stage to the next (the time it has been on
# or off, and its power); sddp_solver builds a new SDDPBlock
# for each simulation and gives the UCBlock of a stage its Solver only after
# the state has been passed, while the InvestmentFunction simulates on the
# UCBlock of the training, whose Variable are already generated.
#
# The instances are written by gen_sddp_initud.py, which also gives the value
# by hand of each: a thermal unit that starts up at the last instant of the
# first stage with MinUpTime 3 (minup3), the same with MinUpTime 1 (minup1),
# and one that is off at the end of the first stage as the data of the second
# say (noswitch). The design is fixed at its installed quantity, at no cost,
# and the volume of the reservoir, the state, cannot change, so that the
# decisions of a simulation do not depend on the cuts. They take seconds,
# hence they all run in CI too.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

ibexe="${1:-./investmentblock_solver}"
sddpexe="${2:-./sddp_solver}"
py="${3:-python3}"
mlf="${4:-}"

# the absolute paths of the executables, since the tools are run in the
# directory where the instances are written, and of the suite, where the
# configurations are
for _v in ibexe sddpexe; do
    _p="${!_v}"
    [[ "${_p}" == */* ]] && printf -v "${_v}" '%s' "$( cd "$( dirname \
        "${_p}" )" && pwd )/$( basename "${_p}" )"
done
suite="$( cd "$( dirname "$0" )/.." && pwd )"

# relative tolerance on the values compared
EPS="${EPS:-1e-6}"

# one thread, rather than as many as the machine has, idle: the
# InvestmentFunction would simulate the two scenarios in parallel, but on the
# one sub-Block per stage of the SDDPBlock, one after the other all the same,
# and their logs, which give the costs of the stages, would be mixed
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# the instances, the outputs of the tools and their logs are written in a
# directory of their own, removed at the end
work="$( mktemp -d )"
trap 'rm -rf "${work}"; report_skipped' EXIT

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ variant ] = mean of the costs of the simulations, by hand

declare -A REF_OBJ
eval "$( "${py}" "${suite}/gen_sddp_initud.py" "${work}" )" || exit 1

# output - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

say() {
    if [ -z "${mlf}" ]; then
        printf "%b\n" "$*"
    else
        printf "%b\n" "$*" >> "${mlf}"
    fi
}

# runs a tool in the working directory, its output in the given log and its
# errors (and warnings) in the same with .err appended
run_tool() {
    local _log=$1
    shift
    ( cd "${work}" && "$@" ) > "${work}/${_log}" 2> "${work}/${_log}.err"
    local _rv=$?
    if [ ${_rv} -ne 0 ]; then
        say "${RED}$* returned ${_rv}${NC}"
        cat "${work}/${_log}" "${work}/${_log}.err"
        exit 1
    fi
}

# the value after the given label in a log
value_of() {
    grep -m1 "^$2" "${work}/$1" | awk '{ print $NF }'
}

# the costs of the stages in the simulation of the given scenario in a log,
# i.e., the Present column of the log of the SDDPGreedySolver
stage_costs() {
    awk -v k="$2" '( NF == 6 ) && ( $1 ~ /^[0-9]+$/ ) && ( $2 == k ) {
        printf "%s%g", sep, $3; sep = " " }' "${work}/$1"
}

# whether two values agree within EPS
agree() {
    awk -v a="$1" -v b="$2" -v e="${EPS}" 'BEGIN {
        d = a - b; if( d < 0 ) d = -d
        m = ( b < 0 ? -b : b ); if( m < 1 ) m = 1
        exit( ( d <= e * m ) ? 0 : 1 ) }'
}

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfg=( -c "${suite}/" -B InnerBCfg-sddp.txt )
failed=0

for v in minup3 minup1 noswitch; do

    print_header "${v} ${REF_OBJ[$v]}"

    # the InvestmentFunction at the design: training, then simulations
    run_tool "ib_${v}.log" "${ibexe}" -o "${cfg[@]}" -S BSPar.txt \
             "ib_sddp_${v}.nc4"
    ib=$( value_of "ib_${v}.log" "Solution value:" )

    # sddp_solver: training, then one simulation per scenario on the cuts
    mkdir -p "${work}/${v}"
    run_tool "train_${v}.log" "${sddpexe}" "${cfg[@]}" \
             -S SDDPSCfg-sddp.txt -d "${v}" "sddp_${v}.nc4"
    sum=0
    for i in 0 1; do
        run_tool "sim_${v}_${i}.log" "${sddpexe}" -s -i ${i} "${cfg[@]}" \
                 -S SDDPSCfg-sddp-sim.txt -l "${v}/BellmanValuesOUT.nc4" \
                 -d "${v}" "sddp_${v}.nc4"
        ub=$( value_of "sim_${v}_${i}.log" "Upper bound:" )
        sum=$( awk -v s="${sum}" -v u="${ub}" \
                   'BEGIN { printf "%.12g", s + u }' )
    done
    sddp=$( awk -v s="${sum}" 'BEGIN { printf "%.12g", s / 2 }' )
    [ -n "${ib}" ] && ib=$( awk -v x="${ib}" 'BEGIN { printf "%.12g", x }' )

    # what the InvestmentFunction says about the state it could not pass
    grep "Warning: a ThermalUnitBlock" "${work}/ib_${v}.log.err" | \
        while read -r line; do say "  ${line}"; done

    # the costs of the stages of each simulation, side by side
    for i in 0 1; do
        say "  scenario ${i}, costs of the stages: InvestmentFunction" \
            "$( stage_costs "ib_${v}.log" ${i} ), sddp_solver" \
            "$( stage_costs "sim_${v}_${i}.log" ${i} )"
    done

    verdict="${GREEN}OK${NC}"
    if [ -z "${ib}" ] || ! agree "${ib}" "${sddp}"; then
        verdict="${RED}KO: the InvestmentFunction differs from"
        verdict+=" sddp_solver${NC}"
        failed=1
    elif ! agree "${sddp}" "${REF_OBJ[$v]}"; then
        verdict="${RED}KO: sddp_solver differs from the reference${NC}"
        failed=1
    fi
    say "  InvestmentFunction ${ib:-none}  sddp_solver ${sddp}  Ref" \
        "${REF_OBJ[$v]}  -> ${verdict}"
done

exit ${failed}
