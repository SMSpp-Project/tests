#!/usr/bin/env bash
#
# usage: batch-stochastic < exe file > < bpar file > < spar file > < log file >
#        < exe file > = path of the executable file, default IB_test
#        < bpar file > = BlockConfig file, default InnerBCfg.txt
#        < spar file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs the instances where the InvestmentBlock wraps a whole stochastic Block,
# a TwoStageStochasticBlock or a MultiStageStochasticBlock, rather than a
# single UCBlock: the design is the Variable of the master, the
# InvestmentFunction is the value function and the scenarios are the
# subproblems, all solved at once by the Solver registered on the stochastic
# Block. The instances are emitted by pypsa2smspp with investment_outside,
# which states the investment once outside the scenarios instead of once per
# scenario, and the reference is the objective of the equivalent flat network
# solved by PyPsa.
#
# NOTE: the inner Block is solved by Gurobi, see BSCfg1.txt: HiGHS grinds for a
# thousand seconds on these instances and then reports an error. Switching that
# file leaves batch-pypsa identical, verified line by line.
#
# NOTE: these runs are given an initial point, and it is not optional. Over
# part of the design space the inner Block is infeasible, because scaling the
# design of a line scales its minimum power flow along with the maximum, so a
# line with a positive minimum is forced to carry a flow its neighbours at
# design zero cannot absorb. There the InvestmentFunction returns +infinity
# and no linearization, the master has no feasibility cut with which to cut
# the point away, and the run stops declaring the stability centre optimal.
# Starting inside the box the trajectory never enters that region.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
# NOTE: this batch takes a BlockConfig (bpar) + BlockSolverConfig (spar) pair
# rather than the standard (par, slv); we map them onto the helper's $par/$slv
# slots so that `parse_batch_args` and `run_test` work unchanged.
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./IB_test
DEFAULT_PAR=InnerBCfg.txt
DEFAULT_SLV=BSPar.txt
parse_batch_args "$@"
bpar=$par
spar=$slv

# the BlockConfig of the second run, the inner Block solved by the recursive
# Lagrangian dual; empty where the LagrangianDualSolver is not in the build
ld_bcfg="${IB_LD_BCFG-InnerBCfg-LD.txt}"

# the initial point, the lower bound of the box plus 10000 on every asset,
# which the instances of the tree of network_small_fewsectors need and share,
# their design boxes being the same; the others start from the default one
declare -A POINT
POINT[smspp_stoch_tssb_c3_d3_renewables.nc]=initial_investment_stochastic.txt
POINT[smspp_stoch_tssb_c3_d3_both.nc]=initial_investment_stochastic.txt
POINT[smspp_stoch_mssb_c3_d3_both.nc]=initial_investment_stochastic.txt

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = PyPsa objective value of the equivalent flat
# network; the three instances describe the same scenario tree, once as nine
# flat scenarios and once as three subtrees of three, hence the same value

declare -A REF_OBJ

REF_OBJ[smspp_stoch_tssb_c3_d3_renewables.nc]=3.488357705e+09
REF_OBJ[smspp_stoch_tssb_c3_d3_both.nc]=3.488357705e+09
REF_OBJ[smspp_stoch_mssb_c3_d3_both.nc]=3.488357705e+09

# a modular network of gen_modular_tssb.py with the modules turned off, once
# as a TSSB and once as an MSSB over two outer realizations, whose
# ucblock form is solved by BendersDecompositionSolver in
# TwoStageStochasticBlock/batches/batch-pypsa-modular
REF_OBJ[smspp_mod_t48_s10_b2c_investment_outside.nc]=3.6823506884e+07
REF_OBJ[smspp_mod_t48_s10_b2c_o2_mssb_investment_outside.nc]=3.6823506884e+07

# the instances also run with the inner Block solved by the recursive
# Lagrangian dual (InnerBCfg-LD.txt), their inner Block being a linear program
declare -A LD_INNER
LD_INNER[smspp_mod_t48_s10_b2c_investment_outside.nc]=1
LD_INNER[smspp_mod_t48_s10_b2c_o2_mssb_investment_outside.nc]=1

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ../../InvestmentBlock/data/nc4/pypsa-data/stochastic/smspp_*.nc; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    base=$(basename "$what")
    ref=${REF_OBJ[$base]}

    if [ -z "$ref" ]; then
      echo "No reference objective defined for file: $base"
      exit 1
    fi

    point=${POINT[$base]}
    run_test "$exe" -B "$bpar" -S "$spar" ${point:+-x "$point"} -o "$ref" "$what"
    # the modular networks again, the inner Block being solved by the
    # recursive Lagrangian dual instead of a linear program: the nested form
    # of an ad hoc Benders decomposition with a Lagrangian dual inside
    if [ -n "${ld_bcfg}" ] && [ -n "${LD_INNER[$base]}" ]; then
      run_test "$exe" -B "${ld_bcfg}" -S "$spar" -o "$ref" "$what"
    fi

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
