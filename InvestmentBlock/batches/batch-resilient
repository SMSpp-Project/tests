#!/usr/bin/env bash
#
# usage: batch-resilient < exe file > < bpar file > < spar file > < log file >
#        < exe file > = path of the executable file, default InvestmentBlock_test
#        < bpar file > = BlockConfig file, default MetaConfig1.txt
#        < spar file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# runs all the energy community instances and checks that the PyPsa objective
# value matches the given reference one

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
# NOTE: this batch takes a BlockConfig (bpar) + BlockSolverConfig (spar) pair
# rather than the standard (par, slv); we map them onto the helper's $par/$slv
# slots so that `parse_batch_args` and `run_test` work unchanged. The runtime
# call passes a hardcoded `0` between $spar and $ref to match the existing
# executable CLI (exe what bpar spar 0 ref).
source "$(dirname "$0")/../../batch_common.sh"

DEFAULT_EXE=./InvestmentBlock_test
DEFAULT_PAR=MetaConfig1.txt
DEFAULT_SLV=BSPar.txt
parse_batch_args "$@"
bpar=$par
spar=$slv

# reference objective values dictionary - - - - - - - - - - - - - - - - - - -
# each entry: [ filename ] = PyPsa objective value

declare -A REF_OBJ

REF_OBJ[smspp_1n_1c_1gext.nc]=3.969365408e+08
REF_OBJ[smspp_2n_1c_1gext_1bext_2l.nc]=4.116252931e+08
REF_OBJ[smspp_2n_1c_1gext_1bext_2lext.nc]=9.019791121e+07
REF_OBJ[smspp_2n_2c_1g_1lext.nc]=6.626444342e+08
REF_OBJ[smspp_3n_3c_1gext_1h_1bext_2l.nc]=5.983456337e+08
REF_OBJ[smspp_inv_1n_1c_1g_ext.nc]=4.109344639e+08
REF_OBJ[smspp_inv_2n_1c_1g_1b_ext.nc]=4.168985026e+08

# run all the instances - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ../../InvestmentBlock/data/nc4/resilient-data/smspp_*.nc; do

    # skip if pattern did not match any file
    if [ ! -f "$what" ]; then
      continue
    fi

    base=$(basename "$what")
    ref=${REF_OBJ[$base]}

    if [ -z "$ref" ]; then
      echo "No reference objective defined for file: $base"
      exit 1
    fi

    run_test "$exe" "$what" "$bpar" "$spar" 0 "$ref"

done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
