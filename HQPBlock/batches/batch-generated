#!/usr/bin/env bash
#
# usage: batch-generated < exe file > < par file > < log file >
#        < exe file > = path of the executable, default HQPBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#
# Every HQPSolver of the BlockSolverConfig against the null-space reference,
# hence against each other, on the hierarchies that the tester builds: the
# random ones, those with degenerate levels (no equalities, no inequalities,
# nothing), an inequality task that cannot be satisfied at its level and
# one already satisfied, dependent rows, weights, a step of Model Predictive
# Control that changes all the data of the same HQPBlock, and a run of 10
# small such steps, where DAQP and qpOASES starting from the previous solve
# of each level (the 1st and the 4th HQPSolver of BSPar.txt) must take fewer
# iterations than the same ones solving from scratch (the 13th and the 14th,
# -I).
#
# The interior-point inner Solvers of BSPar.txt (MOSEK, Clarabel: the 7th to
# the 12th HQPSolver) are held to 1e-5 on the values of the levels rather
# than 1e-6: an inequality task that a level satisfies exactly leaves them
# with a slack of the order of the square root of their accuracy, which the
# next levels see (e.g., the third level of the infeasible and satisfied
# tasks with the center of the regularization at 0).

# run from the test directory so HQPBlock_test reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./HQPBlock_test
DEFAULT_PAR=BSPar.txt
parse_batch_args "$@"

run_test "$exe" -S "$par" -E ,,,,,,1e-5,1e-5,1e-5,1e-5,1e-5,1e-5 \
  -I 1:13,4:14

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
