#!/usr/bin/env bash
#
# usage: batch < exe file > < log file >
#        < exe file > = path of the executable file, default ./CFL_test
#        < log file > = name of the log file, default no log (stdout)
#
# default arrangement: B1 is the natural-formulation LP, B2 is the MCF flow
# relaxation; runs a largish set of ORLib, Yang and TBED instances and checks
# that the two lower bounds coincide along a sequence of random modifications

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

# run from the test root (one level up) so CFL_test reads the default config
# files (BPar*, BSPar*, R3BCfg) there
cd "$(dirname "$0")/.." || exit 1


DATADIR=../../CapacitatedFacilityLocationBlock/data

CFL_test=${1:-./CFL_test}
mlf=${2:-}

niter=0
# wchg = 831 = all data changes + abstract representation (+256) + the +512
# ("set eps & no negative design") bit, always required with a MCF R3Block
wchg=831
rounds=40
maxseed=2

# ORLib - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for what in ${DATADIR}/txt/ORLib/*.txt; do

  for (( seed = 0 ; seed <= maxseed ; seed++ )); do

    run_test "$CFL_test" "$what" c "$niter" "$seed" "$wchg" "$rounds"

  done
done

# Yang and TBED are skipped in CI: a single one of these instances runs for
# hours (40 re-solve rounds on a large facility-location problem), far past
# any CI budget. ORLib above gives the regression signal; local runs the lot.
if [ -n "$CI" ]; then
  exit 0
fi

# Yang - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for i in 30-200 60-200 60-300 80-400; do
  for (( h = 1 ; h <= 5 ; h++ )); do
    for (( seed = 0 ; seed <= maxseed ; seed++ )); do

      what=${DATADIR}/txt/Yang/${i}/${i}-${h}.txt

      run_test "$CFL_test" "$what" l "$niter" "$seed" "$wchg" "$rounds"

    done
  done
done

# TBED - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for i in 300; do            # 300_1500 500 700 1000
  for h in 1 6 11 16 19; do #for (( h = 1 ; h <= 10 ; h++ ))
    for (( seed = 0 ; seed <= maxseed ; seed++ )); do

      what=${DATADIR}/txt/TBED/${i}/i${i}_${h}.txt

      run_test "$CFL_test" "$what" f "$niter" "$seed" "$wchg" "$rounds"

    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
