#!/usr/bin/env bash
#
# usage: batch-cuts < exe file > < log file >
#        < exe file > = path of the executable file, default ./CFL_test
#        < log file > = name of the log file, default no log (stdout)
#
# user-cuts arrangement: the natural formulation and a copy in the knapsack
# formulation, each solved by a :MILPSolver that separates the strong forcing
# constraints; runs ORLib, Yang and TBED instances

# the common part, which reads the arguments [see cfl_battery.sh]
source "$(dirname "$0")/cfl_battery.sh" "$@"

# the original Block, whose BlockSolverConfig solves an R3Block of it
forms=CFLBForm-cuts.txt

# wchg = 831 = all data changes + abstract representation (+256) + the +512
# ("set eps & no negative design") bit
wchg=831
maxseed=2

# ORLib - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# the small ones: on the capa, capb and capc ones, with 1000 customers, the
# separation takes some 25 seconds per solve, hence hours per instance
cfl_orlib "${cfl_orlib_small[@]}"

# Yang and TBED: the 40 rounds take up to 12 seconds on a Yang instance and
# some 11 on a TBED one, so CI runs the first instance of each Yang size and
# the first TBED one with seed 0 only (some 1 minute), and a local run all
# of them with all the seeds (some 12 minutes, with the small ORLib ones)
if [ -n "$CI" ]; then
  maxseed=0
  yang=1
  tbed=1
else
  yang=
  tbed="$(seq 1 10)"
fi

# Yang - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_yang $yang

# TBED - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_tbed $tbed

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
