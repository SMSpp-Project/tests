#!/usr/bin/env bash
#
# usage: batch-cuts < exe file > < log file >
#        < exe file > = path of the executable file, default ./CFL_test
#        < log file > = name of the log file, default no log (stdout)
#
# user-cuts arrangement: B2 is a copy CapacitatedFacilityLocationBlock solved
# by a :MILPSolver with dynamic cut separation; runs ORLib, Yang and TBED
# instances

# the common part, which reads the arguments [see cfl_battery.sh]
source "$(dirname "$0")/cfl_battery.sh" "$@"

# the original Block and its R3Block, each with its configuration
forms=CFLBForm-cuts.txt

# wchg = 831 = all data changes + abstract representation (+256) + the +512
# ("set eps & no negative design") bit
wchg=831
maxseed=2

# ORLib - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_orlib

# Yang and TBED: the 40 rounds take up to 2 seconds on a Yang instance and
# some 5 on a TBED one, so CI runs the first instance of each Yang size and
# the first TBED one with seed 0 only (some 5 seconds), and a local run
# all of them with all the seeds (some 4 minutes)
if [ -n "$CI" ]; then
  maxseed=0
  yang=1
  tbed=1
else
  yang=
  tbed="$(seq 1 10)"
fi

# Yang - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_yang $yang

# TBED - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_tbed $tbed

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
