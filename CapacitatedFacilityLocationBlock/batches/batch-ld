#!/usr/bin/env bash
#
# usage: batch-ld < exe file > < log file >
#        < exe file > = path of the executable file, default ./CFL_test
#        < log file > = name of the log file, default no log (stdout)
#
# Lagrangian-dual arrangement: B2 is a copy CapacitatedFacilityLocationBlock
# in the knapsack formulation solved by a LagrangianDualSolver (BundleSolver
# driving the dual, an LP leaf via :MILPSolver on the subproblems); runs the small
# ORLib instances

# the common part, which reads the arguments [see cfl_battery.sh]
source "$(dirname "$0")/cfl_battery.sh" "$@"

# the original Block and its R3Block, each with its configuration
vars=CFLBVar-ld.txt

# wchg = 257 = change facility costs (bit 0) and the abstract representation
# (+256)
wchg=257
maxseed=1

# ORLib - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cfl_orlib "${cfl_orlib_small[@]}"

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
