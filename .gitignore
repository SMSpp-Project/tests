# ============================================================
#  tests/ — .gitignore
# ============================================================

# --- Project-specific: per-test binaries --------------------
# a suite lives in the directory of the module its tests are posed on, hence
# the binaries a run leaves behind are matched wherever the suite is, save
# for the two scripts of the scenario reduction that end in the same way
*_test
*_bench
!UCBlock/scenario-reduction/run_uc_test
!UCBlock/scenario-reduction/UCInvestmentTest/run_investment_test
BinaryKnapsackBlock/BinaryKnapsackBlock_test
CapacitatedFacilityLocationBlock/CFL_test
compare_formulations/compare_formulations
InvestmentBlock/IB_test
LukFiBlock/LukFi_test
MCF_MILP/MCF_MILP_test
MMCFBlock/MMCF_test
MMCFBlock/gen/Mnetgen/mnetgen
MMCFBlock/gen/Canad
MMCFBlock/gen/JLF
MILPSolver/QuadraticTests/quad_test
SingleFlowDCRBlock/SingleFlowDCRBlock_test
TwoStageStochasticBlock/TSSB_test
MultiStageStochasticBlock/MSSB_test

# Large data / generated inputs
MMCFBlock/data/*

MMCFBlock/gen/Canad.tgz
InvestmentBlock/investment_candidates.txt
CapacitatedFacilityLocationBlock/LD/CFL*.txt

# the netCDF files the SVM serialization checks write
SVMBlock/svmblock.nc4
SVMBlock/svmsolution.nc4

# Solver-side run output
# *.bn = BundleSolver log; *.lp = MILPSolver LP dump
*.bn
*.lp
SMS++/AbstractBlock/*.mps

