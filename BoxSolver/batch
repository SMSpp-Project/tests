#!/usr/bin/env bash
#
# usage: batch < exe file > < par file >
#        < exe file > = path of the executable file, default ./BoxSolver_test
#        < par file >  = BlockSolverConfig file, default BSCfg.txt
#
# sweeps BoxSolver_test over a range of problem sizes, 20 seeds each

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../batch_common.sh"

what=3
#iter=0

BoxSolver_test=${1:-./BoxSolver_test}
par=${2:-BSCfg.txt}

for size in 2 10 50 100 1000; do
  for (( seed = 0 ; seed < 20 ; seed++ )); do

    run_test "$BoxSolver_test" -S "$par" -e "$seed" -k "$what" -N "$size" -n "$iter"

  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
