#!/usr/bin/env bash
#
# usage: batch-dense < exe file > < fw exe >
#        < exe file > = path of the executable file, default ./MCFBlock_test
#        < fw exe >    = the generic Frank-Wolfe tester, optional: given
#                       one, a few of the same instances are also solved by
#                       the Frank-Wolfe decomposition of a father Block of K
#                       copies of them
#
# runs the dense net/goto MCF instances through the MCFBlock-vs-MILP
# comparison, over 3 seeds each
#
# the dense instances of the sweep, which are the ones that cost: they are a
# batch of their own so that neither half approaches the three hour cap a job
# has on the GitLab.com shared runners. batch is the rest of the sweep.
#
# each instance is run twice, with two "what to change" masks:
# - 255 = change everything, arc deletions included: this exercises the full
#         remove_arc/add_arc Modification path, but deletions can permanently
#         drop arcs needed for feasibility (the emergency recovery can re-open
#         closed arcs but cannot un-delete removed ones), so a run may degrade
#         into mostly-infeasible cross-checks;
# - 223 = everything *except* arc deletions (255 & ~32): the instance always
#         stays feasible, so this is the run that delivers the meaningful
#         solution-vs-solution comparisons.
# the two are complementary: 255 for code-path coverage, 223 for comparison
# value.

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../MCFBlock/data

# "what to change" masks: 255 = all (with arc deletions), 223 = all but
# deletions (255 & ~32); see the header for the rationale
wchg_list="255 223"
#rounds=40

MCFBlock_test=${1:-./MCFBlock_test}
fwexe=${2:-}
# the Solver of BSPar.txt but the two LEMON algorithms that are slow on
# these instances, see BSPar-large.txt
par=BSPar-large.txt

for type in net goto; do

  for (( seed = 0; seed < 3 ; seed++ )); do

    for sz in 10_64; do
      for h in 1 2 3 4 5; do

        what=${DATADIR}/nc4/${type}${sz}_${h}.nc4

        for wchg in $wchg_list; do
          run_test "$MCFBlock_test" "$what" -S "$par" -e "$seed" -k "$wchg"
        done # wchg

      done # h
    done   # sz

  done # seed
done   # type

# the same instances, decomposed by Frank-Wolfe - - - - - - - - - - - - - - -
# K copies of the Block become the sub-Block of a father whose Objective
# couples them, each of them solved by its network simplex as the Linear
# Minimization Oracle and the Oracle of the K run in parallel; the value
# FrankWolfeSolver computes is cross-checked against the monolithic
# :MILPSolver of the same configuration. Only a few of the instances above are
# run this way, these being the large ones.

if [ -n "${fwexe}" ]; then

  FWCFG=FW/FWCfg.txt
  FWSAVE=$( cat "$FWCFG" )
  trap '[ -n "$FWSAVE" ] && printf "%s\n" "$FWSAVE" > "$FWCFG"' EXIT
  cfg_set_par "$FWCFG" intMaxThread 4

  # the diagonal quadratic father, vanilla Frank-Wolfe: one run, the
  # instances of this battery carrying some 65 thousand arcs each
  cfg_set_par "$FWCFG" intAlgorithm 0
  fwargs="-o 0 -k 2 -e 1"
  fw_run ${DATADIR}/nc4/goto10_64_1.nc4

  cfg_set_par "$FWCFG" intMaxThread 1

fi

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
