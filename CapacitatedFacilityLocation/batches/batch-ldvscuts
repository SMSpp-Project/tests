#!/usr/bin/env bash
#
# usage: batch-ldvscuts < exe file > < log file >
#        < exe file > = path of the executable file, default ../CFL_test
#        < log file > = name of the log file, default no log (stdout)
#
# Lagrangian-dual vs cuts arrangement: same knapsack Lagrangian-dual R3Block
# as batch-ld, configured to be contrasted with the user-cuts setting; runs
# the small ORLib instances.
#
# NOTE: this batch is deliberately NOT on the ctest pipeline (see CMakeLists).
# It compares two genuinely *different* valid lower bounds:
#   B1 = cut-strengthened LP bound  (demand kept exact; CFLB separates the
#        per-facility strong forcing x_ij <= y_i, and the :MILPSolver adds
#        generic / cross-facility cuts on top);
#   B2 = integer-knapsack Lagrangian dual (demand relaxed, decomposed per
#        facility -> only the per-facility knapsack closure is reachable).
# Their difference is NOT sign-definite, so the default 1e-5 equality cannot
# hold on every instance (it is not a bug, and no solver / leaf / bundle-tuning
# config removes it: B2 is identical with the DP and the :MILPSolver integer
# leaves and immune to bundle tuning). Out of 136 (instance,seed,wchg in
# {1,257}) runs,
# 131 agree to ~1e-9; the 5 that exceed 1e-5 (max relative gap over 40 rounds):
#   wchg=257:  cap64/seed0 1.83e-4   cap42/seed0 6.70e-4   cap51/seed0 1.906e-3 (max)
#   wchg=1  :  cap44/seed0 3.87e-4   cap62/seed1 6.84e-4
# To run it anyway as a loose-tolerance sanity check, uncomment the run_test
# line below that passes cmptol=2e-3 (just above the 1.906e-3 max) and comment
# out the default one.

# run from the LDVScuts config directory so CFL_test reads its config files
# (BPar*, BSPar*, R3BCfg) there
cd "$(dirname "$0")/../LDVScuts" || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$(dirname "$0")/../../batch_common.sh"

DATADIR=../../../CapacitatedFacilityLocationBlock/data

CFL_test=${1:-../CFL_test}
mlf=${2:-}

niter=0
# wchg = 257 = change facility costs (bit 0) and the abstract representation
# (+256)
wchg=257
rounds=40
maxseed=1

# ad-hoc relative tolerance that absorbs the legitimate LD-vs-cuts bound
# difference documented above (just above the 1.906e-3 max); only used by the
# commented-out run_test variant below
cmptol=2e-3

# ORLib - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for f in 102 113 124 42 62 73 91 103 114 131 43 63 74 92 104 121 132 44 \
  64 81 93 111 122 134 51 71 82 94 112 123 41 61 72 84; do
  for (( seed = 0 ; seed <= maxseed ; seed++ )); do

    what=${DATADIR}/txt/ORLib/cap${f}.txt

    run_test "$CFL_test" "$what" c "$niter" "$seed" "$wchg" "$rounds"
    # ... or, with the ad-hoc tolerance, all instances pass (#chng %chng cmptol):
    # run_test "$CFL_test" "$what" c "$niter" "$seed" "$wchg" "$rounds" 10 0.5 "$cmptol"

  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
