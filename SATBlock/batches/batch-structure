#!/usr/bin/env bash
#
# usage: batch-structure < exe file > < par file > < log file > < satgen >
#        < exe file > = path of the executable, default SATBlock_test
#        < par file > = BlockSolverConfig file, default BSPar-LD.txt
#        < log file > = name of log file, default no log
#        < satgen >   = path of smspp_satgen, default smspp_satgen
#
# Cross-check on random weighted partial MaxSAT instances made of groups of
# clauses bound by a fraction of linking clauses, written by smspp_satgen
# with a planted assignment and the groups of the variables, each one given
# both structures out of its groups [see SATBlock::set_structure()]: the
# relaxation of BPar-R.txt and the decomposition of BPar-D.txt, the list of
# SATBForm.txt, the instance being read once per structure and the Solver of
# the two copies compared with each other as well. The Solver
# of BSPar-LD.txt that see the whole instance must give the same optimum,
# and the LagrangianDualSolver, the last one, declared to solve a relaxation
# by -R, a lower bound on it. Each instance is then changed 3 times by the
# Modification of SATBlock_test -n, which keep the structure, the
# cross-check being repeated after each, which is how the Solver, the
# LagrangianDualSolver included, reoptimize.

# run from the test directory so SATBlock_test reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./SATBlock_test
DEFAULT_PAR=BSPar-LD.txt
parse_batch_args "$@"
satgen="${4:-smspp_satgen}"

# the instances are written in a directory of their own, removed at the end
dir="$(mktemp -d)"
trap 'rm -rf "${dir}"; report_skipped' EXIT

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for k in 2 4; do
  for n in 10 20; do
    for f in 0.05 0.2; do
      for seed in 1 2; do
        inst="${dir}/k${k}_n${n}_f${f}_s${seed}.nc4"
        "${satgen}" -k "$k" -n "$n" -f "$f" -g 2 -P -s "$seed" "${inst}" \
          || exit 1
        run_test "$exe" -F SATBForm.txt -S "$par" -R ",,,,r" -n 3 \
          -e "$seed" "${inst}"
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
