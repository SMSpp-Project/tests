#!/usr/bin/env bash
#
# usage: batch-groups < exe file > < par file > < log file > < satgen >
#        < exe file > = path of the executable, default SATBlock_test
#        < par file > = BlockSolverConfig file, default BSPar.txt
#        < log file > = name of log file, default no log
#        < satgen >   = path of smspp_satgen, default smspp_satgen
#
# Cross-check on random weighted partial MaxSAT instances made of groups of
# clauses bound by a fraction of linking clauses, the structure the
# decompositions are for, written by smspp_satgen with a planted assignment,
# so that the hard clauses are satisfiable: every Solver of BSPar.txt, OLL on
# the clauses and the :MILPSolver on the MILP formulation, must give the same
# optimum, which here is not known beforehand.

# run from the test directory so SATBlock_test reads its config files
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.." || exit 1

# shared CLI/run helpers - - - - - - - - - - - - - - - - - - - - - - - - - -
source "$here/../../batch_common.sh"

DEFAULT_EXE=./SATBlock_test
DEFAULT_PAR=BSPar.txt
parse_batch_args "$@"
satgen="${4:-smspp_satgen}"

# the instances are written in a directory of their own, removed at the end
dir="$(mktemp -d)"
trap 'rm -rf "${dir}"' EXIT

# sweep- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

for k in 2 4; do
  for n in 10 20; do
    for f in 0 0.05 0.2; do
      for seed in 1 2 3; do
        inst="${dir}/k${k}_n${n}_f${f}_s${seed}.wcnf"
        "${satgen}" -k "$k" -n "$n" -f "$f" -g 2 -P -s "$seed" "${inst}" \
          || exit 1
        run_test "$exe" -S "$par" "${inst}"
      done
    done
  done
done

# the end - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
